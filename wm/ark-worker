def utc():
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def json_bytes(value):
    return json.dumps(value, ensure_ascii=False, allow_nan=False, separators=(",", ":")).encode()


def frame(value):
    payload = json_bytes(value)
    return struct.pack("!I", len(payload)) + payload


def proc_identity(pid):
    try:
        fields = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()
        return None if fields[0] == "Z" else fields[19]
    except (OSError, IndexError):
        return None


def marked(pid, state, sid):
    try:
        env = set(Path(f"/proc/{pid}/environ").read_bytes().split(b"\0"))
        return {os.fsencode(f"ARK_SESSIOND={state}"),
                os.fsencode(f"ARK_SESSION_ID={sid}")}.issubset(env)
    except OSError:
        return False


class AdoptedOpenbox:
    """Popen-shaped lifecycle for an earlier generation's surviving WM."""
    def __init__(self, pid, starttime):
        self.pid, self.starttime = pid, starttime

    def poll(self):
        return None if proc_identity(self.pid) == self.starttime else 0

    def send_signal(self, sig):
        if self.poll() is None:
            try:
                os.kill(self.pid, sig)
            except ProcessLookupError:
                pass

    def terminate(self):
        self.send_signal(signal.SIGTERM)

    def kill(self):
        self.send_signal(signal.SIGKILL)

    def wait(self):
        if self.poll() is None:
            wait_pid(self.pid, 2)
        return self.poll()


def verify_x_binding(r):
    # Xorg is root-owned (sessiond launches it through sudo). Its environ
    # and fd links need not be readable by us; cmdline, stat and the X lock
    # are ownership-independent evidence tying the registry PID to display.
    number, pid = r["display"], r["pid_x"]
    if not Path(f"/tmp/.X11-unix/X{number}").is_socket():
        raise RuntimeError("x_socket_missing")
    try:
        args = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
        expected = "Xorg" if r["profile"] == "xorg" else "Xvfb"
        matches = (Path(os.fsdecode(args[0])).name == expected
                   and os.fsencode(f":{number}") in args[1:]
                   and int(Path(f"/tmp/.X{number}-lock").read_text()) == pid)
    except (OSError, ValueError):
        matches = False
    if not matches:
        raise RuntimeError("x_identity_mismatch")


@contextmanager
def registry(state):
    # No mkdir: this worker binds an existing built session only.
    with (state / ".lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield json.loads((state / "sessions.json").read_text())


def session_record(records, sid, state):
    if not re.fullmatch(r"s[1-9][0-9]*", sid) or sid not in records:
        raise RuntimeError("unknown_session")
    r = dict(records[sid])
    if r["session"] != sid or type(r["display"]) is not int or not 91 <= r["display"] <= 120:
        raise RuntimeError("display_out_of_range")
    if r["profile"] not in ("xvfb", "xorg"):
        raise RuntimeError("backend_unsupported")
    r["_x_starttime"] = proc_identity(r["pid_x"])
    if not r["_x_starttime"]:
        raise RuntimeError("x_server_dead")
    sd = state / "run" / sid
    if Path(r["session_dir"]).resolve() != sd.resolve():
        raise RuntimeError("session_path_mismatch")
    for key, name in (("home", "home"), ("runtime_dir", "runtime")):
        if Path(r[key]).resolve() != (sd / name).resolve() or not Path(r[key]).is_dir():
            raise RuntimeError("session_path_mismatch")
    for key in ("bus_address", "atspi_address"):
        if not isinstance(r.get(key), str) or not r[key].startswith("unix:"):
            raise RuntimeError("session_bus_missing")
    verify_x_binding(r)
    return r


def session_env(r, state):
    # Deliberately allowlist; inherited host buses, HOME, DISPLAY, XAUTHORITY,
    # SESSION_MANAGER and desktop activation variables never reach children.
    return {"PATH": "/usr/local/bin:/usr/bin:/bin", "LANG": "C.UTF-8",
            "LC_ALL": "C.UTF-8", "DISPLAY": f':{r["display"]}',
            "HOME": r["home"], "XDG_RUNTIME_DIR": r["runtime_dir"],
            "DBUS_SESSION_BUS_ADDRESS": r["bus_address"],
            "AT_SPI_BUS_ADDRESS": r["atspi_address"],
            "ARK_SESSIOND": str(state), "ARK_SESSION_ID": r["session"]}


def encode_control(generation, epoch=1, state=0, flags=0, lease_hash=bytes(16)):
    return PAGE.pack(b"ARKC", 1, bytes.fromhex(generation), epoch, state, flags, 0, lease_hash)


def decode_control(data, generation=None):
    if len(data) != PAGE.size:
        raise ValueError("invalid_control_size")
    magic, version, gen, epoch, state, flags, permit, lease = PAGE.unpack(data)
    if magic != b"ARKC" or version != 1 or state not in STATES.values() or not epoch or permit:
        raise ValueError("malformed_control")
    if generation is not None and gen.hex() != generation:
        raise ValueError("stale_generation")
    return {"generation": gen.hex(), "epoch": epoch, "state": state,
            "flags": flags, "permit_deadline_ns": permit, "lease_hash": lease.hex()}


def transition_control(page, state, epoch, store=control_store):
    # Closing: state first. Opening: epoch first. Never rewrite a live page
    # using a 64-byte memcpy, which could expose AGENT with the old epoch.
    if state == STATES["agent"]:
        store(page, 24, epoch, 64)
        store(page, 32, state, 32)
    else:
        store(page, 32, state, 32)
        store(page, 24, epoch, 64)


def initialise_control(path, generation):
    try:
        fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        with path.open("r+b") as stream:
            fcntl.flock(stream, fcntl.LOCK_EX)
            old = decode_control(stream.read())
            with mmap.mmap(stream.fileno(), 64) as page:
                # Close before changing identity; preserve owner pause/takeover.
                control_store(page, 32, STATES["quiescing"], 32)
                page[8:24] = bytes.fromhex(generation)
                page[36:64] = bytes(28)
                transition_control(page, old["state"], old["epoch"] + 1)
                page.flush()
            os.fsync(stream.fileno())
    else:
        with os.fdopen(fd, "wb") as stream:
            stream.write(encode_control(generation))
            stream.flush()
            os.fsync(stream.fileno())


class ActionOffsets:
    """No receipts/requests here: just offsets into one generation's JSONL."""
    __slots__ = ("request_hash", "intent", "receipt", "armed", "reconciliation")

    def __init__(self):
        self.request_hash = self.intent = self.receipt = None
        self.armed, self.reconciliation = [], []


class Journal:
    def __init__(self, path, session, generation):
        self.path, self.session, self.generation = path, session, generation
        self.stream = path.open("ab")
        self.index, self.index_error = {}, False
        try:
            self._reindex()
        except (OSError, ValueError):
            self.index_error = True

    def _index_row(self, index, row, offset):
        if row.get("session") != self.session or row.get("generation") != self.generation:
            return
        kind, action_id = row.get("type"), row.get("action_id")
        if kind not in ("intent", "receipt", "step_armed", "reconciliation") or not isinstance(action_id, str):
            return
        digest = action_digest(action_id)
        entry = index.get(digest)
        if entry is None:
            entry = index[digest] = ActionOffsets()
        if kind == "intent":
            entry.intent, entry.request_hash = offset, row.get("request_hash")
        elif kind == "receipt":
            entry.receipt = offset
            entry.armed.clear()
        elif kind == "step_armed":
            entry.armed.append(offset)
        else:
            entry.reconciliation.append(offset)

    def _reindex(self):
        index = {}
        with self.path.open("rb") as stream:
            while True:
                offset = stream.tell()
                line = stream.readline()
                if not line:
                    break
                row = json.loads(line)
                if not line.endswith(b"\n") or not isinstance(row, dict):
                    raise ValueError("journal_unavailable")
                self._index_row(index, row, offset)
        self.index, self.index_error = index, False

    def append(self, kind, **fields):
        value = {"ts": utc(), "type": kind, "session": self.session,
                 "generation": self.generation, **fields}
        self.stream.seek(0, os.SEEK_END)
        offset = self.stream.tell()
        self.stream.write(json_bytes(value) + b"\n")
        self.stream.flush()
        os.fsync(self.stream.fileno())
        # Publish offsets only after fsync succeeds. Storage recovery rebuilds
        # the index after validating and syncing an uncertain append.
        self._index_row(self.index, value, offset)
        return offset

    def close(self):
        self.stream.close()

    def validate(self):
        # Used only for owner-authorized storage recovery, never per input.
        # A writable disk does not repair a torn JSONL tail.
        self.stream.flush()
        os.fsync(self.stream.fileno())
        try:
            self._reindex()
        except (OSError, ValueError):
            self.index_error = True
            raise

    def entry(self, action_id):
        if self.index_error:
            raise RPCError("journal_unavailable")
        return self.index.get(action_digest(action_id))

    def action(self, action_id, offset=None):
        """Current generation: seek only this action's indexed JSONL rows."""
        entry = self.entry(action_id)
        if entry is None:
            return {"status": "not_found", "action_id": action_id}
        if offset is not None and offset != entry.receipt:
            raise RPCError("journal_unavailable")
        try:
            with self.path.open("rb") as stream:
                def read(at, kind):
                    stream.seek(at)
                    line = stream.readline()
                    row = json.loads(line)
                    if (not line.endswith(b"\n") or row.get("action_id") != action_id or
                            row.get("type") != kind or row.get("session") != self.session or
                            row.get("generation") != self.generation):
                        raise ValueError("journal_unavailable")
                    return row
                if entry.receipt is not None:
                    receipt = read(entry.receipt, "receipt")["receipt"]
                else:
                    receipt = recover_receipt(read(entry.intent, "intent"),
                                              [read(at, "step_armed")["step_id"] for at in entry.armed])
                reconciliations = [self.reconciliation(read(at, "reconciliation")) for at in entry.reconciliation]
        except FileNotFoundError:
            raise RPCError("history_expired")
        except (OSError, ValueError, TypeError, KeyError, AttributeError):
            raise RPCError("journal_unavailable")
        return {"status": "final", "receipt": receipt, "reconciliation": reconciliations}

    @staticmethod
    def reconciliation(row):
        return {key: row[key] for key in ("step_id", "rev", "effect")}

    def unresolved(self):
        """Recover admission blockers across generations, without replaying input."""
        actions, reconciled, proven = {}, set(), set()
        paths = sorted(self.path.parent.glob("*.jsonl"), key=lambda p: p.stat().st_mtime_ns)
        for path in paths:
            with path.open(encoding="utf-8") as stream:
                for line in stream:
                    row = json.loads(line)
                    if row.get("session") != self.session:
                        continue
                    kind = row.get("type")
                    key = (row.get("generation"), row.get("action_id"))
                    if kind == "intent":
                        actions[key] = {"intent": row, "armed": [], "receipt": None}
                    elif kind == "step_armed" and key in actions:
                        actions[key]["armed"].append(row["step_id"])
                    elif kind == "receipt" and key in actions:
                        actions[key]["receipt"] = row["receipt"]
                    elif kind in ("reconciled", "reconciliation"):
                        source = (row.get("action_generation", row["generation"]), row["action_id"])
                        if kind == "reconciled":
                            reconciled.add(source)
                        else:
                            proven.add((*source, row["step_id"]))
        pending = []
        # Stable journal order breaks ties between intents with the same timestamp.
        for key, action in sorted(actions.items(), key=lambda item: item[1]["intent"]["ts"]):
            if key in reconciled:
                continue
            receipt = action["receipt"]
            if receipt is None:
                receipt = recover_receipt(action["intent"], action["armed"])
            for effect in receipt["pending_effects"]:
                if effect["action_id"] == key[1] and (*key, effect["step_id"]) not in proven:
                    pending.append(dict(effect, generation=key[0]))
        return pending

    @staticmethod
    def history_action(path, action_id):
        intent, receipt, armed, reconciliations = None, None, [], []
        try:
            with path.open(encoding="utf-8") as stream:
                for line in stream:
                    row = json.loads(line)
                    if row.get("action_id", row.get("receipt", {}).get("action_id")) == action_id:
                        if row.get("type") == "intent":
                            intent = row
                        elif row.get("type") == "receipt":
                            receipt = row.get("receipt", row)
                        elif row.get("type") == "step_armed":
                            armed.append(row["step_id"])
                        elif row.get("type") == "reconciliation":
                            reconciliations.append(Journal.reconciliation(row))
        except FileNotFoundError:
            raise RPCError("history_expired")
        except (OSError, ValueError):
            if intent is not None:
                unknown = recover_receipt(intent, armed)
                unknown["reason"] = "journal_unavailable"
                return {"status": "final", "receipt": unknown, "history_complete": False,
                        "reconciliation": reconciliations}
            raise RPCError("journal_unavailable")
        if intent is None:
            return {"status": "not_found", "action_id": action_id}
        if receipt is not None:
            return {"status": "final", "receipt": receipt, "reconciliation": reconciliations}
        return {"status": "final", "receipt": recover_receipt(intent, armed), "reconciliation": reconciliations}


class StateCache:
    """Immutable JSON metadata and per-facet revisions; no X calls here."""
    REMOVED_LIMIT = 4096  # ~80 KiB at Step-0's 19.6 bytes/handle.

    def __init__(self, session, generation):
        self.session, self.generation = session, generation
        self.rev, self.next_window = 1, 1
        self.windows, self.removed = {}, {}
        self.stacking = []  # Client XIDs, bottom to top.
        self.tombstones = {}
        self.history_floor, self.removed_elided = 1, 0
        self.focus, self.modal, self.pointer = None, [], None
        self.screen = None
        self.control = None
        self.facets = {"windows": 1, "focus": 1, "modal": 1, "control": 1, "pointer": 1}
        self.changed = set()
        self.upserts = set()
        self.last_window = {}

    def handle(self, xid):
        return self.windows.get(xid, {}).get("handle")

    def upsert(self, xid, value):
        old = self.windows.get(xid)
        value = dict(value)
        if old is None:
            value["handle"] = f"{self.session}/g{self.generation[:8]}/w{self.next_window}"
            self.next_window += 1
        else:
            value["handle"] = old["handle"]
        if value == old:
            return
        self.windows[xid] = value
        self.upserts.add(xid)
        if old is None or old.get("geometry") != value.get("geometry"):
            self.changed.add("geometry[" + value["handle"] + "]")
        self.changed.add("windows")

    def remove(self, xid):
        old = self.windows.pop(xid, None)
        if old:
            self.removed[old["handle"]] = self.rev + 1
            self.tombstones[old["handle"]] = old
            self.changed.add("windows")
            self.upserts.discard(xid)

    def set(self, name, value):
        if getattr(self, name) != value:
            setattr(self, name, value)
            self.changed.add(name)

    def commit(self, event_batch=False):
        if not self.changed and not event_batch:
            return
        self.rev += 1
        for facet in self.changed:
            self.facets[facet] = self.rev
        for xid in self.upserts:
            self.last_window[xid] = self.rev
        self.changed.clear()
        self.upserts.clear()

    def baseline(self):
        self.rev = 1
        self.facets = dict.fromkeys(self.facets, 1)
        self.last_window = dict.fromkeys(self.windows, 1)
        self.removed.clear()
        self.tombstones.clear()
        self.history_floor, self.removed_elided = 1, 0
        self.changed.clear()
        self.upserts.clear()

    def removed_history(self):
        # During an act the backing history is pinned, but observations must
        # still fit the wire budget. Project the same tail without evicting.
        rows = list(self.removed.items())
        excess = max(0, len(rows) - self.REMOVED_LIMIT)
        floor = max(self.history_floor, rows[excess - 1][1]) if excess else self.history_floor
        return rows[excess:], floor, self.removed_elided + excess

    def known_revision(self, since):
        _, floor, _ = self.removed_history()
        return type(since) is int and floor <= since <= self.rev

    def prune_history(self):
        """Only called at worker safe points, never during an active batch."""
        if self.changed or self.upserts:
            return  # Removal revisions must be committed before advancing floor.
        excess = max(0, len(self.removed) - self.REMOVED_LIMIT)
        for h in list(self.removed)[:excess]:
            self.history_floor = max(self.history_floor, self.removed.pop(h))
            self.tombstones.pop(h, None)
            self.facets.pop('geometry[' + h + ']', None)
        self.removed_elided += excess
        self.last_window = {xid: rev for xid, rev in self.last_window.items() if xid in self.windows}
        # Provider.prune_closed has discarded these publications. In particular
        # tree facets must not survive indefinitely after unmap or forget.
        mapped = {w['handle'] for w in self.windows.values() if w['mapped']}
        for facet in list(self.facets):
            if facet.startswith('tree[') and facet[5:-1] not in mapped:
                del self.facets[facet]

    def selected(self, scope):
        if not isinstance(scope, dict) or any(k not in ("kind", "window", "handle") for k in scope):
            raise RPCError("invalid_params")
        kind = scope.get("kind", "session")
        if kind not in ("session", "window", "family"):
            raise RPCError("invalid_params")
        if kind == "session":
            if "window" in scope or "handle" in scope:
                raise RPCError("invalid_params")
            return list(self.windows.values())
        handle = scope.get("window", scope.get("handle"))
        if not isinstance(handle, str) or not handle.startswith(
                f"{self.session}/g{self.generation[:8]}/"):
            raise RPCError("stale_generation")
        target = next((w for w in self.windows.values() if w["handle"] == handle), None)
        if target is None:
            target = self.tombstones.get(handle)
            if target is None:
                raise RPCError("target_not_found")
        if kind == "window":
            return [w for w in self.windows.values() if w["handle"] == handle]
        if kind == "family":
            return [w for w in self.windows.values() if w["family"] == target["family"]]
        raise RPCError("invalid_params")

    def observe(self, scope, since, covered=True, pixel_tiles=None, tree_window=None):
        windows = self.selected(scope)
        history, floor, elided = self.removed_history()
        known = type(since) is int and floor <= since <= self.rev
        # Integer comparisons only. Conservative across scopes: a change in
        # another window can yield an empty delta, never a false unchanged.
        unchanged = known and covered and max((rev for facet, rev in self.facets.items()
                if (not facet.startswith("tree[") or facet == "tree[" + str(tree_window) + "]") and
                (not facet.startswith("pixels[") or pixel_tiles is None or
                int(facet[7:-1]) in pixel_tiles)), default=1) <= since
        full = not known
        result = {"rev": self.rev, "generation": self.generation,
                  "unchanged": bool(unchanged), "full": full}
        if not covered:
            result.update(unchanged=None, resync_required=True)
        if not unchanged:
            selected = {w["handle"] for w in windows}
            kind = scope.get("kind", "session")
            target_handle = scope.get("window", scope.get("handle"))
            target = next((w for w in self.windows.values() if w["handle"] == target_handle),
                          self.tombstones.get(target_handle))
            removed = [h for h, rev in history if (full or rev > since) and
                       (kind == "session" or (kind == "window" and h == target_handle) or
                        (kind == "family" and target and self.tombstones[h]["family"] == target["family"]))]
            result["state"] = {
                "windows": [dict(w, geometry_rev=self.facets.get("geometry[" + w["handle"] + "]", 1))
                            for xid, w in self.windows.items() if w["handle"] in selected
                            and (full or self.last_window.get(xid, 1) > since)],
                "removed": removed,
                "focus": self.focus, "modal": self.modal, "pointer": self.pointer,
                "control": self.control, "screen": self.screen}
            if full and kind == 'session':
                result['state']['removed_elided'] = elided
        return result


class RPCError(Exception):
    def __init__(self, reason, detail=None, code=-32000):
        self.reason, self.detail, self.code = reason, detail, code
        super().__init__(reason)


class AsyncX:
    """python-xlib nonblocking reply pump (0.33); no reply()/sync() calls."""
    def __init__(self, connection, fatal):
        self.connection, self.fatal = connection, fatal
        self.pending = []
        connection.set_error_handler(self.on_error)

    def on_error(self, exc, req):
        # Xlib swallows handler exceptions, so report to the owner explicitly.
        self.fatal.append(exc)

    def ask(self, cls, callback, *, optional=False, error_callback=None, **args):
        req = cls(display=self.connection.display, defer=True, **args)
        self.pending.append((req, callback, optional, error_callback))

    def pump(self):
        events = []
        while self.connection.pending_events():
            events.append(self.connection.next_event())
        pending, self.pending = self.pending, []
        for req, callback, optional, error_callback in pending:
            if req._error is not None:
                if error_callback is not None:
                    error_callback(req._error)
                elif optional and isinstance(req._error, (error.BadWindow, error.BadDrawable)):
                    callback(None)
                else:
                    raise req._error
            elif req._data is not None:
                callback(req._data)
            else:
                self.pending.append((req, callback, optional, error_callback))
        return events

    def flush(self):
        self.connection.flush()  # python-xlib flush uses select(timeout=0).


def xid(value):
    return value.id if hasattr(value, "id") else int(value or 0)


def prop_values(reply):
    # Low-level GetProperty retains (format, data); Window.get_property()
    # normally unwraps this, but also blocks waiting for the reply.
    return reply["value"][1] if reply and reply.get("property_type") else []


class XState:
    def __init__(self, worker):
        self.w = worker
        if type(worker.record["display"]) is not int or not 91 <= worker.record["display"] <= 120:
            raise RuntimeError("display_out_of_range")
        if worker.record.get("_x_starttime"):
            if proc_identity(worker.record["pid_x"]) != worker.record["_x_starttime"]:
                raise RuntimeError("x_identity_mismatch")
            verify_x_binding(worker.record)
        # These explicit names cannot fall back to the host DISPLAY. The
        # initial X protocol handshake is inside python-xlib's constructor.
        self.ev = display.Display(f':{worker.record["display"]}')
        self.ax = AsyncX(self.ev, worker.x_errors)
        self.inp = display.Display(f':{worker.record["display"]}')
        self.inp.set_error_handler(self.ax.on_error)
        self.ev.display.socket.setblocking(False)
        self.inp.display.socket.setblocking(False)
        self.root = self.ev.screen().root
        self.atoms, self.versions = {}, {}
        self.clients, self.refreshing, self.again = set(), set(), set()
        self.incarnations = {}
        self.selected_windows, self.uncovered = set(), set()
        self.focus_xid, self.input_focus = 0, 0
        self.ancestors, self.ignored = {}, set()
        self.root_order = []
        self.initialised, self.wm_ready = False, False
        self.phase = "versions"
        for name in ("XTEST", "DAMAGE", "XFIXES", "XInputExtension"):
            if not self.ev.has_extension(name):
                raise RuntimeError("missing_extension:" + name)
        for name, cls, major, minor in (
                ("XInputExtension", xinput.XIQueryVersion, 2, 2),
                ("DAMAGE", damage.QueryVersion, 1, 1),
                ("XFIXES", xfixes.QueryVersion, 4, 0),
                ("XTEST", xtest.GetVersion, 2, 2)):
            self.ax.ask(cls, lambda d, n=name: self.version(n, d),
                        opcode=self.ev.display.get_extension_major(name),
                        major_version=major, minor_version=minor)
        # Negotiate on inp too before its reserved XTEST use in W2.
        self.inp_ax = AsyncX(self.inp, worker.x_errors)
        self.inp_ax.ask(xtest.GetVersion, lambda d: None,
                         opcode=self.inp.display.get_extension_major("XTEST"),
                         major_version=2, minor_version=2)
        for name in ATOM_NAMES:
            self.ax.ask(request.InternAtom, lambda d, n=name: self.atoms.__setitem__(n, d["atom"]),
                        only_if_exists=False, name=name)
        self.ax.ask(request.GetGeometry, self.screen, drawable=self.root)

    def screen(self, data):
        formats = self.ev.display.info.pixmap_formats
        if data["depth"] != 24 or not any(f.depth == 24 and f.bits_per_pixel == 32 for f in formats):
            raise RuntimeError("unsupported_visual")
        self.w.screen = {"w": data["width"], "h": data["height"]}
        self.w.cache.set("screen", dict(self.w.screen))
        pixels = getattr(self.w, "pixels", None)
        if pixels is None or (pixels.shadow.w, pixels.shadow.h) != (data["width"], data["height"]):
            if pixels:
                pixels.shadow.close()
            path = self.w.sd / "fb/Xvfb_screen0" if self.w.record["profile"] == "xvfb" else None
            self.w.pixels = Pixels(self.w, Shadow(data["width"], data["height"], path,
                                                 self.ev.display.info.image_byte_order))

    def version(self, name, data):
        version = (data["major_version"], data["minor_version"])
        if name == "XInputExtension" and version < (2, 2):
            raise RuntimeError("missing_extension:XInputExtension>=2.2")
        self.versions[name] = ".".join(map(str, version))

    def property(self, window, name, callback):
        self.ax.ask(request.GetProperty, callback, optional=True, window=window,
                    property=self.atoms[name], type=X.AnyPropertyType, delete=False,
                    long_offset=0, long_length=16384)

    def advance(self):
        if self.phase == "versions" and not self.ax.pending and not self.inp_ax.pending:
            self.phase = "wm_check"
            # DAMAGE's version reply must be consumed before DamageCreate.
            self.damage_id = self.root.damage_create(damage.DamageReportRawRectangles)
            self.w.timings["x_ms"] = self.w.elapsed()
            checks = {}
            def checked(key, value):
                checks[key] = value
                if len(checks) != 3:
                    return
                present = (checks["selection"] or checks["check"] or
                           checks["attributes"]["all_event_masks"] & X.SubstructureRedirectMask)
                if present:
                    own = self.w.recorded_openbox()
                    if own is None or own.poll() is not None:
                        stale_wm()
                        return
                    # Openbox's WM-check/selection windows have no _NET_WM_PID.
                    # The validated process identity and root redirect ownership
                    # are sufficient: two live WMs cannot own this root.
                    self.w.openbox = own
                    launch(False)
                else:
                    launch(True)
            def stale_wm():
                if (checks["selection"] or len(checks["check"]) != 1 or
                        not checks["check"][0] or
                        checks["attributes"]["all_event_masks"] & X.SubstructureRedirectMask or
                        not self.w.recorded_openbox_dead()):
                    raise RuntimeError("wm_already_running")
                def exists(_):
                    raise RuntimeError("wm_already_running")
                def missing(exc):
                    if not isinstance(exc, error.BadWindow):
                        raise RuntimeError("wm_already_running")
                    # Recheck presence after the BadWindow round trip. A WM
                    # taking over while the proof was pending must still win.
                    latest = {}
                    def verified(key, value):
                        latest[key] = value
                        if len(latest) != 3:
                            return
                        if (latest["selection"] or latest["check"] != checks["check"] or
                                latest["attributes"]["all_event_masks"] & X.SubstructureRedirectMask or
                                not self.w.recorded_openbox_dead()):
                            raise RuntimeError("wm_already_running")
                        self.root.delete_property(self.atoms["_NET_SUPPORTING_WM_CHECK"])
                        # Consume the deletion before starting a WM on another
                        # connection; a buffered delete must never erase the
                        # fresh child's newly published check property.
                        self.ax.ask(request.GetInputFocus, lambda _: launch(True))
                    self.ax.ask(request.GetSelectionOwner,
                                lambda d: verified("selection", xid(d["owner"])),
                                selection=self.atoms["WM_S0"])
                    self.property(self.root, "_NET_SUPPORTING_WM_CHECK",
                                  lambda d: verified("check", list(prop_values(d))))
                    self.ax.ask(request.GetWindowAttributes,
                                lambda d: verified("attributes", d), window=self.root)
                self.ax.ask(request.GetWindowAttributes, exists, error_callback=missing,
                            window=checks["check"][0])
            def launch(spawn):
                self.root.change_attributes(event_mask=X.SubstructureNotifyMask | X.PropertyChangeMask
                                            | X.StructureNotifyMask | X.PointerMotionMask)
                # Version negotiation has completed before this first XI use.
                self.root.xinput_select_events([(xinput.AllMasterDevices, xinput.MotionMask)])
                if spawn:
                    self.w.start_openbox()
                else:
                    self.w.read_openbox_version()
                self.phase = "wm_wait"
                self.check_wm()
            self.ax.ask(request.GetSelectionOwner, lambda d: checked("selection", xid(d["owner"])),
                        selection=self.atoms["WM_S0"])
            self.property(self.root, "_NET_SUPPORTING_WM_CHECK",
                          lambda d: checked("check", list(prop_values(d))))
            self.ax.ask(request.GetWindowAttributes, lambda d: checked("attributes", d), window=self.root)
        if self.phase == "initial" and not self.ax.pending and not self.refreshing:
            self.derive()
            if not self.w.settle_pixels():
                return
            self.w.cache.baseline()
            self.initialised = True
            self.phase = "channel_setup"
            self.w.act = Engine(self.w, XTestTransport(self.w))
        if self.phase == "channel_setup" and self.w.act.t.initialised and not self.ax.pending:
            if self.w.record["profile"] == "xorg":
                evdev = EvdevTransport(self.w, self.w.act.t)
                self.w.act.evdev = evdev
                mask = (xinput.RawKeyPressMask | xinput.RawKeyReleaseMask | xinput.RawButtonPressMask |
                        xinput.RawButtonReleaseMask | xinput.RawMotionMask | xinput.HierarchyChangedMask)
                self.root.xinput_select_events([(xinput.AllDevices, mask), (xinput.AllMasterDevices, xinput.MotionMask)])
            self.phase = "channel_test"
            self.w.act.start_selftest()
        if self.phase == "channel_test" and self.w.act.selftest is None:
            self.phase = "ready"
            self.w.ready()

    def check_wm(self):
        def checked(data):
            if not prop_values(data) or self.wm_ready:
                return
            self.wm_ready = True
            self.w.timings["wm_ms"] = self.w.elapsed() - self.w.timings["x_ms"]
            self.phase = "initial"
            self.reconcile()
        self.property(self.root, "_NET_SUPPORTING_WM_CHECK", checked)

    def reconcile(self):
        self.property(self.root, "_NET_CLIENT_LIST", self.client_list)
        self.property(self.root, "_NET_ACTIVE_WINDOW", self.active)
        self.ax.ask(request.GetInputFocus, self.got_focus)
        self.ax.ask(request.GetGeometry, self.screen, drawable=self.root)
        self.ax.ask(request.QueryTree, self.root_tree, window=self.root)
        self.w.watchdog = time.monotonic() + 5
        for wid in list(self.w.cache.windows):
            self.refresh(wid)

    def root_tree(self, data):
        self.root_order = [xid(child) for child in data["children"]]
        for child in self.root_order:
            self.refresh(xid(child))

    def client_list(self, data):
        previous = self.clients
        self.clients = {int(v) for v in prop_values(data)}
        for wid in self.clients | previous:
            self.refresh(wid)

    def active(self, data):
        values = prop_values(data)
        self.focus_xid = int(values[0]) if len(values) else self.input_focus

    def got_focus(self, data):
        self.input_focus = xid(data["focus"])
        if not self.focus_xid:
            self.focus_xid = self.input_focus

    def refresh(self, wid):
        if not wid or wid == self.root.id or wid in getattr(self, "ignored", set()):
            return
        if wid in self.refreshing:
            self.again.add(wid)
            return
        self.refreshing.add(wid)
        def finished():
            self.refreshing.discard(wid)
            if wid in self.again:
                self.again.remove(wid)
                self.refresh(wid)
        self.read_window(wid, finished)

    def read_window(self, wid, complete):
        # An independent snapshot: callers wait for this request group only,
        # never for event-driven refreshes or their repeated `again` samples.
        if wid not in self.selected_windows:
            # Select before sampling: changes between GetProperty and event
            # selection must not escape the cache's event coverage.
            self.ev.create_resource_object("window", wid).change_attributes(
                event_mask=X.PropertyChangeMask | X.StructureNotifyMask | X.SubstructureNotifyMask | X.FocusChangeMask,
                onerror=self.window_select_error)
            self.selected_windows.add(wid)
        incarnation = self.incarnations.get(wid, 0)
        values = {}
        names = ("attributes", "geometry", "position", "_NET_WM_NAME", "WM_NAME", "WM_CLASS",
                 "WM_TRANSIENT_FOR", "WM_CLIENT_LEADER", "_NET_WM_STATE",
                 "_NET_WM_WINDOW_TYPE", "_NET_WM_PID")
        ancestry_done = not hasattr(self, "ancestors")
        def finish():
            if len(values) == len(names) and ancestry_done:
                if self.incarnations.get(wid, 0) == incarnation:
                    self.snapshot(wid, values)
                complete()
        def got(name, data):
            values[name] = data
            finish()
        self.ax.ask(request.GetWindowAttributes, lambda d: got("attributes", d), optional=True, window=wid)
        self.ax.ask(request.GetGeometry, lambda d: got("geometry", d), optional=True, drawable=wid)
        self.ax.ask(request.TranslateCoords, lambda d: got("position", d), optional=True,
                    src_wid=wid, dst_wid=self.root, src_x=0, src_y=0)
        # Root hit tests see WM frames. Retain the actual parent chain rather
        # than assuming that matching desktop geometry proves ownership.
        if hasattr(self, "ancestors"):
            def ancestry(node, chain):
                def parent(d):
                    nonlocal ancestry_done
                    if not d:
                        ancestry_done = True
                        finish()
                        return
                    p = xid(d["parent"])
                    if p and p != self.root.id and p not in chain and len(chain) < 8:
                        chain.append(p)
                        ancestry(p, chain)
                    else:
                        self.ancestors[wid] = tuple(chain)
                        ancestry_done = True
                        finish()
                self.ax.ask(request.QueryTree, parent, optional=True, window=node)
            ancestry(wid, [])
        for name in names[3:]:
            self.property(wid, name, lambda d, n=name: got(n, d))

    def sample(self, predicate, target, complete):
        """Refresh predicate dependencies without reconciling the session.

        Discover IDs and probe classifiers on possible candidates. Appearance
        evidence does not depend on a new client's geometry or frame ancestry;
        other predicates retain full snapshots of named/target/focus windows.
        Every callback belongs to this finite sample, even during event churn.
        """
        cancelled = False
        pending = 1
        selected, sampled, probed = set(), set(), set()
        classifiers, invalid = {}, set()
        cache = self.w.cache
        predicates = leaves(predicate)
        appearance = any(p["kind"] in ("window_present", "dialog_present") for p in predicates)
        handles = {h for p in predicates for h in (p.get("window"), p.get("handle"), p.get("parent"))
                   if isinstance(h, str)}
        if target:
            handles.add(target)

        def done():
            nonlocal pending
            pending -= 1
            if pending == 0 and not cancelled:
                self.derive()
                cache.commit()
                result = {"complete": not invalid and not bool(sampled & self.uncovered)}
                if appearance:
                    result.update(classifiers=classifiers, focus_xid=self.focus_xid or self.input_focus)
                complete(result)

        def ask(cls, callback, **args):
            nonlocal pending
            pending += 1
            def got(data):
                if not cancelled:
                    callback(data)
                done()
            self.ax.ask(cls, got, **args)

        def prop(wid, name, callback):
            ask(request.GetProperty, callback, optional=True, window=wid,
                property=self.atoms[name], type=X.AnyPropertyType, delete=False,
                long_offset=0, long_length=16384)

        def select(wid):
            nonlocal pending
            if not wid or wid == self.root.id or wid in selected or wid in getattr(self, "ignored", set()):
                return
            selected.add(wid)
            if appearance and wid not in cache.windows:
                # A new client's frame/geometry/ancestry is not a dependency
                # of an appearance predicate. Its mapped classifiers suffice.
                probe(wid, {})
                return
            sampled.add(wid)
            pending += 1
            self.read_window(wid, done)

        def probe(wid, match):
            # Titles can change without an event, so the cached old title must
            # never exclude a candidate. Read only the requested classifiers.
            names = set()
            incarnation = self.incarnations.get(wid, 0)
            if appearance:
                names.update(("attributes", "_NET_WM_NAME", "WM_NAME", "WM_CLASS", "_NET_WM_WINDOW_TYPE"))
                if any(p["kind"].startswith("dialog") for p in predicates):
                    names.update(("WM_TRANSIENT_FOR", "_NET_WM_STATE"))
            if "title" in match or "title_re" in match:
                names.update(("_NET_WM_NAME", "WM_NAME"))
            if "class" in match:
                names.add("WM_CLASS")
            if "type" in match:
                names.update(("attributes", "_NET_WM_WINDOW_TYPE"))
            if not names:
                select(wid)
                return
            values = {}
            def got(name, data):
                values[name] = data
                if len(values) != len(names):
                    return
                if self.incarnations.get(wid, 0) != incarnation:
                    invalid.add(wid)
                    return
                if any(d and d.get("bytes_after", 0) for d in values.values()):
                    invalid.add(wid)
                    if not appearance or wid in cache.windows:
                        sampled.add(wid)
                        self.uncovered.add(wid)
                    return
                def text(name):
                    return bytes(prop_values(values.get(name))).decode("utf-8", "replace").rstrip("\0")
                candidate = {"title": text("_NET_WM_NAME") or text("WM_NAME"),
                             "class": text("WM_CLASS").split("\0")[-1],
                             "type": "popup" if (values.get("attributes") or {}).get("override_redirect") else
                             "dialog" if self.atoms["_NET_WM_WINDOW_TYPE_DIALOG"] in
                             prop_values(values.get("_NET_WM_WINDOW_TYPE")) else "normal"}
                if appearance:
                    attributes = values.get("attributes")
                    if not attributes:
                        cache.remove(wid)
                        return
                    if attributes["win_class"] == X.InputOnly:
                        return
                    if wid not in self.clients and not attributes["override_redirect"] and wid not in cache.windows:
                        return  # WM frames/check windows are not client arrivals.
                    transient = list(prop_values(values.get("WM_TRANSIENT_FOR")))
                    old = cache.windows.get(wid, {})
                    candidate.update(xid=wid, mapped=attributes["map_state"] != X.IsUnmapped,
                                     transient_for=(int(transient[0]) if transient else None) if
                                     "WM_TRANSIENT_FOR" in names else old.get("transient_for"),
                                     is_modal=self.atoms["_NET_WM_STATE_MODAL"] in
                                     prop_values(values.get("_NET_WM_STATE")) if
                                     "_NET_WM_STATE" in names else old.get("is_modal", False))
                    classifiers[wid] = candidate
                    # Commit fresh classifiers of known windows, including
                    # nonmatches, so unrelated title changes remain visible.
                    old = cache.windows.get(wid)
                    if old:
                        cache.upsert(wid, dict(old, **candidate))
                    return
                if Engine.matches(candidate, match):
                    select(wid)
                else:
                    # Apply fresh negative classifiers too: absence predicates
                    # must not see an old cached match that has disappeared.
                    old = cache.windows.get(wid)
                    if old:
                        fields = {"title" if k == "title_re" else k for k in match}
                        cache.upsert(wid, dict(old, **{k: candidate[k] for k in fields}))
            for name in sorted(names):
                if name == "attributes":
                    ask(request.GetWindowAttributes, lambda d: got("attributes", d), optional=True, window=wid)
                else:
                    prop(wid, name, lambda d, n=name: got(n, d))

        def discover(ids):
            ids = set(cache.windows) | set(ids)
            for i, p in enumerate(predicates):
                if p.get("kind") in ("pointer_at",) or p.get("window") or p.get("handle"):
                    continue
                if p.get("kind") not in ("window_present", "window_absent", "window_focused", "focus_is",
                                         "dialog_present", "dialog_absent"):
                    continue
                for wid in ids:
                    if (wid, i) in probed or wid in getattr(self, "ignored", set()) or wid == self.root.id:
                        continue
                    probed.add((wid, i))
                    probe(wid, p.get("match", {}))

        def discovered(data):
            self.clients = {int(v) for v in prop_values(data)}
            discover(self.clients)
        prop(self.root, "_NET_CLIENT_LIST", discovered)
        def tree(data):
            self.root_order = [xid(v) for v in data["children"]]
            discover(self.root_order)
        ask(request.QueryTree, tree, window=self.root)
        def focus(data):
            self.active(data)
            select(self.focus_xid)
        prop(self.root, "_NET_ACTIVE_WINDOW", focus)
        def input_focus(data):
            self.got_focus(data)
            select(self.input_focus)
        ask(request.GetInputFocus, input_focus)
        def pointer(data):
            cache.set("pointer", {"x": data["root_x"], "y": data["root_y"]})
        ask(request.QueryPointer, pointer, window=self.root)
        for wid, win in list(cache.windows.items()):
            if win["handle"] in handles:
                select(wid)
        done()
        def cancel():
            nonlocal cancelled
            cancelled = True
        return cancel

    def app_build(self, pid, identity):
        # Metadata work, never an executable launch. Cache each binary identity;
        # unknown/foreign PIDs retain the window identity plus generation so
        # unmeasured builds cannot inherit an earlier generation's hints.
        cache = getattr(self, 'build_hashes', None)
        if cache is None:
            self.build_hashes = cache = {}
        try:
            if not pid or not marked(pid, self.w.state, self.w.sid):
                return identity + ':unmeasured:' + self.w.generation
            path = Path(f'/proc/{pid}/exe')
            info = path.stat()
            key = (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns)
            if key not in cache:
                with path.open('rb') as binary:
                    cache[key] = hashlib.file_digest(binary, 'sha256').hexdigest()
            return cache[key]
        except OSError:
            return identity + ':unmeasured:' + self.w.generation

    def snapshot(self, wid, values):
        a, g, p = (values[n] for n in ("attributes", "geometry", "position"))
        if not a or not g or not p:
            self.w.cache.remove(wid)
            return
        popup = bool(a["override_redirect"])
        if (a["win_class"] == X.InputOnly or
                (wid not in self.clients and not popup and wid not in self.w.cache.windows) or
                (popup and a["map_state"] == X.IsUnmapped and wid not in self.w.cache.windows)):
            return
        if any(data and data.get("bytes_after", 0) for data in values.values()):
            self.uncovered.add(wid)
        else:
            self.uncovered.discard(wid)
        def nums(name):
            return list(prop_values(values[name]))
        def first(name):
            seq = nums(name)
            return int(seq[0]) if seq else None
        def text(name):
            val = prop_values(values[name])
            return bytes(val).decode("utf-8", "replace").rstrip("\0") if len(val) else ""
        classes = text("WM_CLASS").split("\0")
        transient = first("WM_TRANSIENT_FOR")
        leader = first("WM_CLIENT_LEADER")
        pid = first("_NET_WM_PID")
        if not hasattr(self, "window_pids"):
            self.window_pids = {}
        self.window_pids[wid] = pid
        old = self.w.cache.windows.get(wid, {})
        fallback = old.get("family")
        focused = self.w.cache.windows.get(self.focus_xid)
        family = (f"x:{transient}" if transient else f"x:{leader}" if leader else
                  f"pid:{pid}" if pid else (focused["family"] if popup and focused else fallback or f"x:{wid}"))
        self.w.cache.upsert(wid, {"xid": wid, "family": family,
            "app_build": self.app_build(pid, classes[-1] if classes else "unknown"),
            "app": classes[-1] if classes else "", "title": text("_NET_WM_NAME") or text("WM_NAME"),
            "class": classes[-1] if classes else "", "instance": classes[0] if classes else "",
            "geometry": {"x": p["x"], "y": p["y"], "w": g["width"], "h": g["height"]},
            "mapped": a["map_state"] != X.IsUnmapped, "type": "popup" if popup else
                "dialog" if self.atoms["_NET_WM_WINDOW_TYPE_DIALOG"] in nums("_NET_WM_WINDOW_TYPE") else "normal",
            "transient_for": transient, "leader": leader,
            "is_modal": self.atoms["_NET_WM_STATE_MODAL"] in nums("_NET_WM_STATE")})

    def derive(self):
        cache = self.w.cache
        # QueryTree is bottom to top; managed clients inherit their frame's
        # root position, while override-redirect windows appear directly.
        order = {wid: i for i, wid in enumerate(getattr(self, "root_order", []))}
        ancestors = getattr(self, "ancestors", {})
        cache.set("stacking", sorted(cache.windows, key=lambda wid: max(
            order.get(node, -1) for node in (wid, *ancestors.get(wid, ())))))
        # Resolve transient chains to the parent's family, including popups.
        for _ in range(len(cache.windows)):
            changed = False
            for wid, win in list(cache.windows.items()):
                parent = cache.windows.get(win["transient_for"])
                if parent and parent["family"] != win["family"]:
                    cache.upsert(wid, dict(win, family=parent["family"]))
                    changed = True
            if not changed:
                break
        focus = cache.windows.get(self.focus_xid) or cache.windows.get(self.input_focus)
        cache.set("focus", focus["handle"] if focus else None)
        family = focus["family"] if focus else None
        cache.set("modal", [w["handle"] for w in cache.windows.values() if w["mapped"]
                  and w["family"] == family and (w["is_modal"] or
                  (w["transient_for"] and w["type"] == "dialog"))])

    def window_select_error(self, exc, req):
        # Selecting a client destroyed between snapshot and request is an
        # expected lifecycle race. All other asynchronous X errors are fatal.
        if not isinstance(exc, error.BadWindow):
            self.w.x_errors.append(exc)
        return 1

    def events(self, events):
        if getattr(self.w, "act", None):
            self.w.act.t.events(events)
            self.w.act.clipboard.events(events)
            if self.w.act.evdev:
                self.w.act.evdev.events(events)
        damage_rects = []
        notified = set()
        for e in events:
            # python-xlib registers a per-connection clone of DamageNotify,
            # not a subclass: isinstance against the imported class misses
            # real wire events. Match this server's negotiated event code.
            if (getattr(self.w, "pixels", None) is not None
                    and e.type == self.ev.extension_event.DamageNotify):
                area = e.area
                damage_rects.append(dict(x=area.x, y=area.y, w=area.width, h=area.height))
                continue
            wid = xid(getattr(e, "window", 0))
            if wid in getattr(self, "ignored", set()):
                continue
            if e.type == X.PropertyNotify:
                notified.add("windows")
                if wid == self.root.id and e.atom == self.atoms["_NET_ACTIVE_WINDOW"]:
                    notified.add("focus")
                if wid == self.root.id:
                    if e.atom == self.atoms["_NET_SUPPORTING_WM_CHECK"]:
                        if not self.wm_ready:
                            self.check_wm()
                    elif e.atom == self.atoms["_NET_CLIENT_LIST"]:
                        self.property(self.root, "_NET_CLIENT_LIST", self.client_list)
                    elif e.atom == self.atoms["_NET_ACTIVE_WINDOW"]:
                        self.property(self.root, "_NET_ACTIVE_WINDOW", self.active)
                elif e.atom in self.atoms.values():
                    self.refresh(wid)
            elif e.type in (X.MapNotify, X.UnmapNotify, X.ConfigureNotify, X.ReparentNotify):
                notified.add("windows")
                self.w.cache.changed.add("stacking")
                self.ax.ask(request.QueryTree, self.root_tree, window=self.root)
                if wid == self.root.id:
                    self.ax.ask(request.GetGeometry, self.screen, drawable=self.root)
                else:
                    self.refresh(wid)
            elif e.type == X.DestroyNotify:
                notified.add("windows")
                self.incarnations[wid] = self.incarnations.get(wid, 0) + 1
                self.selected_windows.discard(wid)
                self.uncovered.discard(wid)
                self.w.cache.remove(wid)
                self.clients.discard(wid)
            elif e.type in (X.FocusIn, X.FocusOut):
                notified.add("focus")
                self.ax.ask(request.GetInputFocus, self.got_focus)
                self.property(self.root, "_NET_ACTIVE_WINDOW", self.active)
            elif e.type == X.MotionNotify:
                self.w.cache.set("pointer", {"x": e.root_x, "y": e.root_y})
            elif e.type == ge.GenericEventCode:
                # Raw payloads have already been handed to the ack consumer.
                continue
        if damage_rects and getattr(self.w, "pixels", None):
            self.w.pixels.mark(damage_rects)
        if getattr(self.w, "resync_baseline", None) is not None:
            self.w.resync_notified.update(notified)
            if getattr(self.w, "pixels", None):
                for rect in damage_rects:
                    self.w.resync_damage.update(self.w.pixels.tiles(rect))
        self.derive()

    def close(self):
        self.inp.close()
        self.ev.close()


class Peer:
    def __init__(self, sock):
        self.sock = sock
        self.incoming, self.outgoing = bytearray(), bytearray()
        self.waits = []


class Worker:
    def __init__(self, state, record, generation, ready_fd):
        self.state, self.record, self.generation = state, record, generation
        self.sid = record["session"]
        self.sd = Path(record["session_dir"])
        self.socket_path = self.sd / "driver/act.sock"
        self.ready_fd = ready_fd
        self.selector = selectors.DefaultSelector()
        self.started = time.monotonic()
        self.timings = {"providers_ms": 0, "selftest_ms": 0}
        self.cache = StateCache(self.sid, generation)
        self.act = None
        self.pixels = None
        self.tree = None
        self.ocr = None
        self.resync_baseline = None
        self.setup_action_profile()
        self.journal = Journal(state / "acts" / (generation + ".jsonl"), self.sid, generation)
        self.counters = dict.fromkeys(("batches", "steps", "verified", "not_observed", "contradicted",
                                      "unknown", "retries", "route_changes", "resync_drift", "false_closes"), 0)
        self.x_errors, self.screen = [], {}
        self.openbox_version = None
        self.x, self.openbox, self.listener = None, None, None
        self.socket_bound = False
        self.peers = set()
        self.lease, self.lease_peer, self.lease_until = None, None, None
        self.stopping, self.published = False, False
        self.stop_reason, self.stop_deadline = "requested", None
        self.watchdog, self.control_due = 0, 0
        self.control_raw = None
        self.control_file = (self.sd / "control").open("rb")
        info = os.fstat(self.control_file.fileno())
        self.control_identity = (info.st_dev, info.st_ino)
        self.control_page = mmap.mmap(self.control_file.fileno(), 64, access=mmap.ACCESS_READ)
        self.wake_r, self.wake_w = os.pipe2(os.O_NONBLOCK | os.O_CLOEXEC)
        self.selector.register(self.wake_r, selectors.EVENT_READ, "signal")
        signal.set_wakeup_fd(self.wake_w)
        for sig in (signal.SIGTERM, signal.SIGINT):
            signal.signal(sig, lambda signum, stack: setattr(self, "stopping", True))

    def elapsed(self):
        return int((time.monotonic() - self.started) * 1000)

    def setup_action_profile(self):
        # Session record may carry the launcher's canonical profile JSON.
        self.profile_data = {"schema": 1, "backend": self.record.get("profile"),
                             "keymap": "server", "locale": "C.UTF-8", "wm": "openbox",
                             "input": {"inter_key_delay_us": 0},
                             "shortcuts": {"select_all": ["Control_L", "a"]}}
        profile_path = self.sd / 'profile.json'
        if 'profile_data' in self.record:
            self.profile_data = self.record['profile_data']
        elif profile_path.exists():
            self.profile_data = json.loads(profile_path.read_text())
        self.profile_hash = hashlib.sha256(canonical(self.profile_data).encode()).hexdigest()
        self.development_flags = FLAGS

    def providers(self):
        result = {name: {"state": "unavailable", "reason": "not_implemented",
                       "sample_rev": None, "age_ms": None, "coverage": "none"}
                for name in ("atspi", "ocr", "tree", "pixels")}
        pixels = getattr(self, "pixels", None)
        if pixels:
            result["pixels"] = {"state": "degraded" if pixels.failure else "healthy",
                                "sample_rev": self.cache.rev, "coverage": "screen",
                                "reason": pixels.failure, "age_ms": 0}
        tree = getattr(self, "tree", None)
        if tree:
            result.update(tree.health())
            result["tree"] = dict(result["atspi"])
        else:
            for name in ("atspi", "tree"):
                result[name].update(state="down", reason="provider_unavailable")
        if getattr(self, 'ocr', None):
            result['ocr'] = self.ocr.health()
            result['fallback_available'] = ['state', 'ocr', 'pixels', 'keyboard']
        return result

    def settle_pixels(self):
        pixels = getattr(self, "pixels", None)
        return pixels is None or pixels.settle()

    def watchdog_start(self):
        if getattr(self, "resync_baseline", None) is not None or not self.settle_pixels():
            return
        self.resync_baseline = (self.cache.rev, dict(self.cache.windows), self.cache.focus)
        self.resync_notified, self.resync_damage = set(), set()
        if getattr(self, "pixels", None):
            self.resync_hashes = list(self.pixels.hashes)
            self.pixels.mark([self.pixels.bounds])
        self.x.reconcile()

    def watchdog_finish(self):
        baseline = getattr(self, "resync_baseline", None)
        if baseline is None or self.x.ax.pending or self.x.refreshing:
            return
        if not self.settle_pixels():
            return
        rev, windows, focus = baseline
        # Normal ingested events already account for their own changes. Count
        # only disagreements found by the independent periodic refresh.
        state_drift = (windows != self.cache.windows and "windows" not in self.resync_notified or
                       focus != self.cache.focus and "focus" not in self.resync_notified)
        pixel_drift = getattr(self, "pixels", None) and any(
            old != new and tile not in self.resync_damage
            for tile, (old, new) in enumerate(zip(self.resync_hashes, self.pixels.hashes)))
        if state_drift or pixel_drift:
            if self.cache.rev == rev:
                self.cache.commit(True)
            self.counters["resync_drift"] += 1
        self.resync_baseline = None

    def channels(self):
        return {"xtest": dict(self.act.channel) if getattr(self, "act", None) else
                          {"state": "untested", "keyboard": "untested", "pointer": "untested"},
                "evdev": dict(self.act.evdev.health, recompiles=self.act.evdev.recompiles) if getattr(self, "act", None) and self.act.evdev else
                         {"state": "untested" if self.record["profile"] == "xorg" else "down",
                          "grab": False, "keyboard": "untested", "recompiles": 0, "last_error":
                          None if self.record["profile"] == "xorg" else "backend_unsupported",
                          "reason": "not_implemented" if self.record["profile"] == "xorg" else "backend_unsupported"},
                "paste": dict(self.act.clipboard.health) if getattr(self, "act", None) else
                         {"state": "unavailable", "reason": "not_created"},
                "atspi": self.tree.health()["atspi"] if getattr(self, "tree", None) else
                         {"state": "down", "reason": "provider_unavailable"}}

    def versions(self):
        return {"python": sys.version.split()[0], "python_xlib": ".".join(map(str, Xlib.__version__)),
                "openbox": self.openbox_version,
                **(self.x.versions if self.x else {})}

    def health(self):
        act = getattr(self, "act", None)
        pending = act.pending_effects[0] if act and act.pending_effects else None
        reason = (act.fence_reason or act.reconciliation_reason()) if act else None
        return {"worker": {"pid": os.getpid(), "generation": self.generation,
                           "state": "stopping" if self.stopping else "fenced" if act and act.fence_reason else
                                    "awaiting_reconciliation" if pending else "ready",
                           "fence_reason": reason,
                           "pending_action_id": pending["action_id"] if pending else None,
                           "pending_action_generation": pending.get("generation", self.generation) if pending else None},
                "session": {"id": self.sid, "profile": self.record["profile"],
                            "display": f':{self.record["display"]}'},
                "rev": self.cache.rev, "control": self.cache.control,
                "channels": self.channels(), "providers": self.providers(),
                "capture": ({"mode": self.pixels.shadow.mode, **self.screen} if getattr(self, "pixels", None)
                            else {"mode": "unavailable", "reason": "not_implemented", **self.screen}),
                "coverage": self.coverage(), "counters": dict(self.counters),
                "versions": self.versions(), "development_flags": FLAGS,
                "profile_hash": getattr(self, "profile_hash", None),
                "human_transport": "unavailable", "awaiting_reconciliation": bool(act and act.pending_effects),
                "pending_effects": act.pending_effects if act else [],
                "lease_suspended": bool(act and act.lease_state.get(self.lease, {}).get("suspended"))}

    def memory_counters(self):
        """Step-0 gauges, sampled only by system.info; never prune or refresh.

        File errors are unknown (null), not zero. pending_x_requests counts
        parent-side AsyncX requests, not server work or buffered X events.
        Schema/units are documented in bench/memory-step0-2026-11-11.md.
        """
        act = getattr(self, 'act', None)
        pixels, tree = getattr(self, 'pixels', None), getattr(self, 'tree', None)
        x = getattr(self, 'x', None)
        frames = pixels.frames if pixels else None
        frame_files = 0
        if frames:
            try:
                with os.scandir(frames.directory) as entries:
                    frame_files = sum(e.name.endswith('.png') and e.is_file() for e in entries)
            except OSError:
                frame_files = None
        try:
            journal_bytes = os.fstat(self.journal.stream.fileno()).st_size
        except (OSError, ValueError):
            journal_bytes = None
        return {"schema": 1,
                "actions_retained": len(act.actions) if act else 0,
                "action_stubs": len(act.action_stubs) if act else 0,
                "journal_actions_indexed": len(self.journal.index),
                "lease_records": len(act.lease_state) if act else 0,
                "removed_windows": len(self.cache.removed),
                "frame_identities": len(frames.issued) if frames else 0,
                "frame_files": frame_files,
                "atspi_apps": len(tree.apps) if tree else 0,
                "atspi_child": getattr(tree, 'child_memory', None) if tree else None,
                "journal_bytes": journal_bytes,
                "pending_x_requests": (sum(len(channel.pending) for channel in
                                           (getattr(x, 'ax', None), getattr(x, 'inp_ax', None))
                                           if channel is not None) if x else None)}

    def coverage(self):
        covered = self.covered()
        reason = None if covered else ("metadata_truncated" if self.x and self.x.uncovered else "refresh_pending")
        return {"state": {"complete": covered, "sample_rev": self.cache.rev,
                          "reason": reason},
                "tree": {"complete": bool(getattr(self, "tree", None) and self.tree.ready and all(
                          self.tree.status(w["handle"]) in ("usable", "empty")
                          for w in self.cache.windows.values() if w["mapped"])),
                         "reason": None if getattr(self, "tree", None) and self.tree.ready and all(
                          self.tree.status(w["handle"]) in ("usable", "empty")
                          for w in self.cache.windows.values() if w["mapped"]) else "provider_degraded"},
                "ocr": self.ocr.coverage() if getattr(self, 'ocr', None) else
                       {"complete": False, "reason": "not_implemented"},
                "pixels": {"complete": bool(getattr(self, "pixels", None) and not self.pixels.failure
                                               and not self.pixels.pending and not self.pixels.dirty),
                           "reason": self.pixels.failure if getattr(self, "pixels", None) else "not_implemented"}}

    def covered(self):
        return bool(self.x and self.x.initialised and not self.x.ax.pending
                    and not self.x.refreshing and not self.x.uncovered and time.monotonic() < self.watchdog)

    def start_openbox(self):
        for version in ("gtk-3.0", "gtk-4.0"):
            settings = Path(self.record["home"]) / ".config" / version / "settings.ini"
            settings.parent.mkdir(parents=True, exist_ok=True)
            try:
                with settings.open("x") as stream:
                    stream.write("[Settings]\ngtk-cursor-blink=false\ngtk-enable-animations=false\n")
            except FileExistsError:
                pass
        self.read_openbox_version()
        with (self.sd / "logs/openbox.log").open("ab") as log:
            self.openbox = subprocess.Popen(["/usr/bin/openbox", "--sm-disable", "--config-file",
                                             str(WM / "openbox-rc.xml")],
                                            env=session_env(self.record, self.state),
                                            cwd=self.record["home"], stdout=log, stderr=log)
        # Persist before baseline/self-test: a kill during startup must also
        # leave enough identity to adopt the surviving WM on the next start.
        identity = {"wm_pid": self.openbox.pid, "wm_starttime": proc_identity(self.openbox.pid)}
        temp = self.sd / "openbox.json.tmp"
        with temp.open("w") as stream:
            json.dump(identity, stream)
            stream.flush()
            os.fsync(stream.fileno())
        temp.replace(self.sd / "openbox.json")

    def recorded_openbox(self):
        try:
            identity_path = self.sd / "openbox.json"
            if not identity_path.exists():
                identity_path = self.sd / "worker.json"
            identity = json.loads(identity_path.read_text())
            pid, stamp = identity["wm_pid"], identity["wm_starttime"]
            if type(pid) is not int or pid <= 0 or not stamp or proc_identity(pid) != stamp:
                return None
            args = Path(f"/proc/{pid}/cmdline").read_bytes().rstrip(b"\0").split(b"\0")
            env = set(Path(f"/proc/{pid}/environ").read_bytes().split(b"\0"))
            if (args != [b"/usr/bin/openbox", b"--sm-disable", b"--config-file", os.fsencode(WM / "openbox-rc.xml")]
                    or not marked(pid, self.state, self.sid)
                    or os.fsencode(f'DISPLAY=:{self.record["display"]}') not in env
                    or proc_identity(pid) != stamp):
                return None
            return AdoptedOpenbox(pid, stamp)
        except (OSError, ValueError, KeyError, TypeError):
            return None

    def recorded_openbox_dead(self):
        # Failure to validate/adopt is not proof of death (permissions, foreign
        # cmdline or a reused live PID must all keep refusing WM replacement).
        try:
            identity_path = self.sd / "openbox.json"
            if not identity_path.exists():
                identity_path = self.sd / "worker.json"
            identity = json.loads(identity_path.read_text())
            pid, stamp = identity["wm_pid"], identity["wm_starttime"]
            if type(pid) is not int or pid <= 0 or not isinstance(stamp, str) or not stamp:
                return False
            try:
                fields = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()
            except (FileNotFoundError, ProcessLookupError):
                return True
            return len(fields) >= 20 and fields[0] == "Z"
        except (OSError, ValueError, KeyError, TypeError, IndexError):
            return False

    def read_openbox_version(self):
        # Package metadata is local and read only; never execute openbox just
        # to get a version (it can write caches before printing --version).
        self.openbox_version = None
        try:
            for package in Path("/var/lib/dpkg/status").read_text().split("\n\n"):
                if package.startswith("Package: openbox\n"):
                    self.openbox_version = next(line[9:] for line in package.splitlines()
                                                if line.startswith("Version: "))
                    break
        except (OSError, StopIteration):
            pass

    def ready(self):
        self.poll_control(force=True)
        self.cache.baseline()
        self.socket_path.parent.mkdir(mode=0o700, exist_ok=True)
        self.socket_path.unlink(missing_ok=True)
        self.listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        previous = os.umask(0o177)
        try:
            self.listener.bind(str(self.socket_path))
            self.socket_bound = True
        finally:
            os.umask(previous)
        self.socket_path.chmod(0o600)
        self.listener.listen(16)
        self.listener.setblocking(False)
        self.selector.register(self.listener, selectors.EVENT_READ, "listener")
        metadata = {"pid": os.getpid(), "generation": self.generation,
                    "wm_pid": self.openbox.pid, "wm_starttime": proc_identity(self.openbox.pid),
                    "socket": str(self.socket_path), "started_at": utc()}
        temp = self.sd / "worker.json.tmp"
        with temp.open("w") as stream:
            json.dump(metadata, stream)
            stream.flush()
            os.fsync(stream.fileno())
        temp.replace(self.sd / "worker.json")
        self.published = True
        self.journal.append("worker_start", profile=self.record["profile"],
                            display=f':{self.record["display"]}', pid=os.getpid(),
                            versions=self.versions(), development_flags=FLAGS)
        self.timings["total_ms"] = self.elapsed()
        self.notify({"session": self.sid, "generation": self.generation,
                     "profile": self.record["profile"], "socket": str(self.socket_path),
                     "state": "ready", "channels": self.channels(), "timings": self.timings})

    def notify(self, value):
        if self.ready_fd is not None:
            os.write(self.ready_fd, json_bytes(value) + b"\n")
            os.close(self.ready_fd)
            self.ready_fd = None

    def poll_control(self, force=False):
        now = time.monotonic()
        if not force and now < self.control_due:
            return
        self.control_due = now + (0.005 if getattr(self, "act", None) and self.act.active else 0.05)
        try:
            info = (self.sd / "control").stat()
            if info.st_size != 64 or (info.st_dev, info.st_ino) != self.control_identity:
                raw = b""
            else:
                # The read-only mapping is held for the generation. Use pread
                # for W1 polling so truncation cannot SIGBUS the daemon before
                # it can report the malformed page as a closed control gate.
                raw = b""
                for _ in range(3):
                    first = os.pread(self.control_file.fileno(), 64, 0)
                    latest = os.pread(self.control_file.fileno(), 64, 0)
                    if first == latest:
                        raw = latest
                        break
                    try:
                        closing = decode_control(latest, self.generation)
                    except ValueError:
                        continue
                    # A valid closing snapshot can only remove authority.
                    # A pause racing these reads is preemption, not a corrupt
                    # page/F4. Opening authority still requires stable reads.
                    if closing['state'] != STATES['agent']:
                        raw = latest
                        break
        except OSError:
            raw = b""
        if raw == self.control_raw:
            return
        self.control_raw = raw
        try:
            value = decode_control(raw, self.generation)
            state = next(k for k, v in STATES.items() if v == value["state"])
            control = {"state": state, "epoch": value["epoch"], "flags": value["flags"]}
        except ValueError as exc:
            control = {"state": "paused", "epoch": None, "reason": str(exc)}
        previous = self.cache.control
        self.cache.set("control", control)
        if getattr(self, "act", None):
            self.act.control_changed(previous, control)
        if previous is not None:
            if getattr(self, "act", None):
                try:
                    self.act.durable("control", previous=previous, **control)
                except ActError:
                    pass
            else:
                self.journal.append("control", previous=previous, **control)

    def accept(self):
        sock, _ = self.listener.accept()
        _, uid, _ = struct.unpack("3i", sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
        if uid != os.getuid():
            sock.close()
            return
        sock.setblocking(False)
        peer = Peer(sock)
        self.peers.add(peer)
        self.selector.register(sock, selectors.EVENT_READ, peer)

    def disconnect(self, peer):
        if peer is self.lease_peer:
            self.lease_peer = None
            self.lease_until = time.monotonic() + 5
        self.peers.discard(peer)
        self.selector.unregister(peer.sock)
        peer.sock.close()

    def respond(self, peer, ident, result=None, exc=None):
        if peer not in self.peers:
            return
        value = {"jsonrpc": "2.0", "id": ident}
        if exc:
            value["error"] = {"code": exc.code, "message": exc.reason,
                              "data": {"reason": exc.reason}}
            if exc.detail:
                value["error"]["data"]["detail"] = exc.detail
        else:
            value["result"] = result
        peer.outgoing.extend(frame(value))
        if len(peer.outgoing) > MAX_FRAME * 8:
            self.disconnect(peer)
        else:
            self.selector.modify(peer.sock, selectors.EVENT_READ | selectors.EVENT_WRITE, peer)

    def io(self, peer, mask):
        try:
            if mask & selectors.EVENT_WRITE and peer.outgoing:
                sent = peer.sock.send(peer.outgoing)
                del peer.outgoing[:sent]
                if not peer.outgoing:
                    self.selector.modify(peer.sock, selectors.EVENT_READ, peer)
            if mask & selectors.EVENT_READ:
                data = peer.sock.recv(65536)
                if not data:
                    self.disconnect(peer)
                    return
                peer.incoming.extend(data)
                while len(peer.incoming) >= 4:
                    size = struct.unpack("!I", peer.incoming[:4])[0]
                    if not 0 < size <= MAX_FRAME:
                        self.disconnect(peer)
                        return
                    if len(peer.incoming) < size + 4:
                        break
                    payload = bytes(peer.incoming[4:size + 4])
                    del peer.incoming[:size + 4]
                    self.ingest()
                    self.message(peer, payload)
        except BlockingIOError:
            pass
        except (BrokenPipeError, ConnectionResetError):
            if peer in self.peers:
                self.disconnect(peer)

    def require_lease(self, peer, params):
        if params.get("generation", self.generation) != self.generation:
            raise RPCError("stale_generation")
        if params.get("session", self.sid) != self.sid:
            raise RPCError("invalid_params")
        if peer is not self.lease_peer or not self.lease or params.get("lease") != self.lease:
            raise RPCError("invalid_lease")

    def expire_lease(self):
        if self.lease_peer is None and self.lease_until is not None and time.monotonic() >= self.lease_until:
            self.release_lease()

    def release_lease(self):
        if getattr(self, 'pixels', None):
            self.pixels.frames.release_lease(self.lease)
        self.lease = self.lease_peer = self.lease_until = None

    def message(self, peer, payload):
        ident = None
        try:
            def invalid_constant(value):
                raise ValueError("nonfinite JSON")
            msg = json.loads(payload, parse_constant=invalid_constant)
            if not isinstance(msg, dict) or msg.get("jsonrpc") != "2.0" or not isinstance(msg.get("method"), str):
                raise RPCError("invalid_request", code=-32600)
            ident = msg.get("id")
            if ident is not None and type(ident) not in (int, str):
                ident = None
                raise RPCError("invalid_request", code=-32600)
            params = msg.get("params", {})
            if not isinstance(params, dict):
                raise RPCError("invalid_params", code=-32602)
            if "id" not in msg:
                return  # No side effects for JSON-RPC notifications in W1.
            method = msg["method"]
            if method == "window.act":
                if not self.settle_pixels():
                    if len(peer.waits) >= 8:
                        raise RPCError("queue_full")
                    peer.waits.append({"kind": "rpc", "id": ident, "params": params, "payload": payload,
                                       "deadline": time.monotonic() + 2})
                    return
                if not hasattr(self, "profile_hash"):
                    self.setup_action_profile()
                if not getattr(self, "act", None):
                    # Startup is not published until the real channel is tested.
                    self.act = Engine(self, None)
                self.act.submit(peer, ident, params)
                return
            self.validate_params(method, params)
            if method in ("window.observe", "window.wait", "session.done"):
                self.require_lease(peer, params)
            if method in ("system.info", "session.attach", "action.get") and not self.settle_pixels():
                if len(peer.waits) >= 8:
                    raise RPCError("queue_full")
                peer.waits.append({"kind": "rpc", "id": ident, "params": params, "payload": payload,
                                   "deadline": time.monotonic() + 2})
                return
            if method == "system.info":
                result = self.health()
                result["memory"] = self.memory_counters()
            elif method == "debug.tree_dump":
                if not getattr(self, "tree", None) or params["window"] not in self.tree.raw:
                    raise RPCError("provider_degraded", "snapshot_unavailable")
                handle = params["window"]
                path = self.sd / ("tree-dump-" + handle.replace("/", "_") + ".json")
                path.write_text(json.dumps(self.tree.raw[handle], ensure_ascii=False, indent=2) + "\n")
                result = {"path": str(path)}
            elif method == "session.attach":
                self.expire_lease()
                if self.lease:
                    raise RPCError("lease_held")
                if params.get("client") not in ("codex", "api") or not isinstance(params.get("name"), str):
                    raise RPCError("invalid_params")
                self.lease, self.lease_peer = secrets.token_hex(16), peer
                self.lease_until = None
                if getattr(self, "act", None):
                    self.act.attach(self.lease, peer, params.get("budget", {}))
                self.journal.append("attach", client=params["client"], name=params["name"],
                                    lease_hash=hashlib.sha256(self.lease.encode()).hexdigest()[:32])
                result = {"lease": self.lease, "session": self.sid, "generation": self.generation,
                          "profile": self.record["profile"], "rev": self.cache.rev, "screen": self.screen,
                          "control_epoch": (self.cache.control or {}).get("epoch"),
                          "channels": self.channels(), "limits": {"steps": 8, "deadline_ms": 10000}}
            elif method == "window.observe":
                self.observe(peer, ident, params)
                return
            elif method == "window.wait":
                self.wait(peer, ident, params)
                return
            elif method == "action.get":
                gen = params.get("generation", self.generation)
                if not isinstance(gen, str) or not re.fullmatch("[0-9a-f]{32}", gen):
                    raise RPCError("invalid_params")
                if not isinstance(params.get("action_id"), str):
                    raise RPCError("invalid_params")
                result = self.act.get(gen, params["action_id"]) if getattr(self, "act", None) else None
                if result is None:
                    result = (self.journal.action(params["action_id"]) if gen == self.generation else
                              Journal.history_action(self.state / "acts" / (gen + ".jsonl"), params["action_id"]))
            elif method == "session.done":
                if params.get("status") not in ("success", "failed", "blocked") or not isinstance(params.get("summary"), str):
                    raise RPCError("invalid_params")
                if getattr(self, "act", None):
                    self.act.durable("done", status=params["status"], summary=params["summary"])
                    self.act.lease_state[self.lease]["done"] = True
                else:
                    self.journal.append("done", status=params["status"], summary=params["summary"])
                self.release_lease()
                result = {}
            else:
                raise RPCError("method_not_found", code=-32601)
            self.respond(peer, ident, result)
        except (UnicodeError, ValueError, RecursionError):
            self.respond(peer, ident, exc=RPCError("parse_error", code=-32700))
        except RPCError as exc:
            self.respond(peer, ident, exc=exc)
        except ActError as exc:
            self.respond(peer, ident, exc=RPCError(exc.reason, exc.detail,
                         code=-32602 if exc.reason in ("invalid_params", "invalid_request", "invalid_expectation") else -32000))

    def validate_params(self, method, params):
        keys = {
            "session.attach": {"client", "name", "budget"},
            "system.info": set(),
            "debug.tree_dump": {"window"},
            "window.observe": {"lease", "scope", "since_rev", "channels", "region", "ignore_regions", "budget", "cursor", "scale"},
            "window.wait": {"lease", "expect", "predicate", "since_rev"},
            "action.get": {"action_id"},
            "session.done": {"lease", "status", "summary"}}
        if method not in keys:
            raise RPCError("method_not_found", code=-32601)
        if set(params) - keys[method] - {"session", "generation", "deadline_ms"}:
            raise RPCError("invalid_params", code=-32602)
        if method == "debug.tree_dump" and (not isinstance(params.get("window"), str) or
                not re.fullmatch(r"[A-Za-z0-9:/_-]+", params["window"])):
            raise RPCError("invalid_params", code=-32602)
        if params.get("session", self.sid) != self.sid:
            raise RPCError("invalid_params")
        if method != "action.get" and params.get("generation", self.generation) != self.generation:
            raise RPCError("stale_generation")
        if "deadline_ms" in params:
            self.deadline(params, 2000, 1, 30000 if method == "window.wait" else 10000)
        def strings(value, depth=0):
            if depth > 32:
                raise RPCError("invalid_params")
            if isinstance(value, str) and "\0" in value:
                raise RPCError("invalid_params")
            if isinstance(value, dict):
                for key, val in value.items():
                    strings(key, depth + 1)
                    strings(val, depth + 1)
            elif isinstance(value, list):
                for val in value:
                    strings(val, depth + 1)
        strings(params)
        if "since_rev" in params and params["since_rev"] is not None and (
                type(params["since_rev"]) is not int or params["since_rev"] < 0):
            raise RPCError("invalid_params")
        if "budget" in params:
            budget = params["budget"]
            allowed = {"acts"} if method == "session.attach" else {"nodes", "bytes"}
            if (not isinstance(budget, dict) or set(budget) - allowed or
                    any(type(v) is not int or v < 0 for v in budget.values())):
                raise RPCError("invalid_params")

    @staticmethod
    def deadline(params, default, low, high):
        ms = params.get("deadline_ms", default)
        if type(ms) is not int or not low <= ms <= high:
            raise RPCError("invalid_params")
        return time.monotonic() + ms / 1000

    def ocr_tree_state(self, handle, providers=None):
        """Observation-only tree view and delivery epoch, scoped to its app.

        Provider publication, admission and public health can lag each other.
        Never use session aggregate severity: it includes unrelated windows.
        """
        tree = getattr(self, 'tree', None)
        if tree is None:
            return dict(publication='down', readiness='down')
        win = tree.window(handle)
        app_key = tree.app(win)
        providers = self.providers() if providers is None else providers
        apps = providers.get('atspi', {}).get('apps', {})
        app = apps.get(app_key)
        if app is None:
            app = next((a for a in apps.values() if handle in a.get('windows', ()) or
                        handle in a.get('window_status', {})), {})
        detail = app.get('window_status', {}).get(handle, {})
        breaker = tree.apps.get(app_key)
        usable = tree.probes.get(handle) == 'usable' and handle in tree.cache.windows
        now = tree.clock()
        mapped_at = tree.first_map.setdefault(handle, now)
        return dict(publication=tree.status(handle), readiness=tree.readiness(handle),
                    breaches=breaker.breaches if breaker else 0, freshness=tree.freshness(handle),
                    app=(app.get('state'), app.get('reason'), app.get('breaches')),
                    window=(detail.get('state'), detail.get('reason')),
                    snapshot=usable,
                    starting=not usable and now-mapped_at < MAP_GRACE)

    @staticmethod
    def ocr_tree_unusable(state):
        """OBSERVE channel order; does not change act-verification readiness."""
        if any(s in ('degraded', 'down') for s in (
                state['publication'], state['readiness'],
                state.get('app', (None,))[0], state.get('window', (None,))[0])):
            return True
        return not state.get('starting', False) and (
            not state.get('snapshot', False) or state['publication'] != 'usable')

    def observation(self, params, wait_ocr=False):
        self.prune_history()
        if not self.settle_pixels():
            raise ActError("provider_degraded", "capture_pending")
        channels = params.get("channels", ["auto"])
        scope, since = params.get("scope", {"kind": "session"}), params.get("since_rev")
        pixels = getattr(self, "pixels", None)
        rect, wins = pixels.region(params) if pixels else (None, [])
        tiles = pixels.tiles(rect) if pixels else None
        ignores = params.get("ignore_regions", [])
        if not isinstance(ignores, list) or len(ignores) > 4:
            raise ActError("invalid_params")
        for raw in ignores:
            ignored, _ = pixels.region(dict(params, region=raw)) if pixels else (None, [])
            if pixels:
                tiles -= {t for t in tiles if intersect(pixels.rects[t], ignored) == pixels.rects[t]}
        tree = getattr(self, "tree", None)
        tree_requested = tree is not None and any(c in ("auto", "tree") for c in channels)
        tree_window = tree.target(scope) if tree_requested else None
        result = self.cache.observe(scope, since, self.covered(), tiles, tree_window)
        result.update(providers=self.providers(), coverage=self.coverage(),
                      channels_used=["state"], settled=self.covered())
        if pixels:
            delta = pixels.delta(rect, None if result["full"] else since)
            if delta:
                delta["tiles"] = [t for t in delta["tiles"] if t in tiles]
                delta["bbox"] = bbox(intersect(pixels.rects[t], rect) for t in delta["tiles"])
                if delta["tiles"]:
                    delta["windows"] = []
                    for win in wins:
                        region = intersect(win["geometry"], rect)
                        changed = [t for t in delta["tiles"] if t in pixels.tiles(region)] if win["mapped"] else []
                        if changed:
                            delta["windows"].append(dict(window=win["handle"], tiles=changed,
                                bbox=bbox(intersect(pixels.rects[t], region) for t in changed)))
                    result["pixels_changed"] = delta
        cursor = params.get("cursor")
        if tree_requested and tree_window and (cursor is not None or any(
                w["handle"] == tree_window and w["mapped"] for w in self.cache.windows.values())):
            tree.consumers[tree_window] = self.lease
            if since is None and cursor is None:
                tree.ensure(tree_window, health=True)
            result["tree"] = dict(window=tree_window, status=tree.status(tree_window))
            usable = tree.probes.get(tree_window) == "usable"
            if cursor is not None or (tree.healthy(tree_window) and
                    tree.probes.get(tree_window) in ("usable", "empty") and
                    tree_window in tree.cache.windows and ("tree" in channels or usable)):
                if not result["unchanged"] or params.get("cursor"):
                    try:
                        state = self.act.lease_state.get(self.lease, {}) if getattr(self, "act", None) else {}
                        baseline = state.get("trees", {}).get(tree_window)
                        tree_since = baseline if not result['full'] and baseline is not None and baseline <= since else None
                        result["tree"] = tree.cache.page(tree_window, tree_since, params.get("cursor"), params.get("budget"),
                                                        dirty=tree_window in tree.dirty)
                        result["channels_used"].append("tree")
                    except ActError as exc:
                        if exc.reason != "provider_degraded":
                            raise
                        result["providers"]["atspi"].update(state="degraded")
                        result["tree"].update(status="degraded", reason=exc.detail)
                        if any(w["handle"] == tree_window and w["mapped"] for w in self.cache.windows.values()):
                            result["providers"]["atspi"]["apps"][tree.app(tree.window(tree_window))].update(
                                state="degraded", reason=exc.detail)
                        if pixels and channels == ["auto"] and not getattr(self, 'ocr', None):
                            result["frames"] = [pixels.frame(rect, wins, params.get("scale"))]
                            result["channels_used"].append("pixels")
            elif pixels and channels == ["auto"] and not result["unchanged"] and not getattr(self, 'ocr', None):
                result["frames"] = [pixels.frame(rect, wins, params.get("scale"))]
                result["channels_used"].append("pixels")
        ocr = getattr(self, 'ocr', None)
        blind = False
        if ocr and pixels:
            handle = tree_window or (tree.target(scope) if tree else None)
            if not handle:
                handle = next((win['handle'] for win in wins if win['mapped'] and win['handle'] == self.cache.focus),
                              next((win['handle'] for win in wins if win['mapped']), None))
            if handle and not any(w['handle'] == handle and w['mapped'] for w in self.cache.windows.values()):
                handle = None
            tree_state = self.ocr_tree_state(handle, result['providers']) if handle else None
            tree_unusable = bool(handle and self.ocr_tree_unusable(tree_state))
            tree_usable = bool(handle and not tree_unusable and
                               tree_state['publication'] == 'usable' and tree_state.get('snapshot'))
            fallback = handle and any(c in ('auto', 'tree') for c in channels) and tree_unusable
            if fallback:
                state = self.act.lease_state.get(self.lease, {}) if getattr(self, 'act', None) else {}
                region = intersect(rect, pixels.window(handle)['geometry'])
                served = state.get('ocr_trees', {}).get(handle)
                if served != (tree_state, region):
                    result['unchanged'] = False
            if not result['unchanged'] and handle and ('ocr' in channels or fallback):
                lines = ocr.read(handle, rect)
                if lines is None and wait_ocr and ocr.state != 'down':
                    raise OCRPending()
                if lines is not None:
                    result['ocr'] = dict(window=handle, lines=lines)
                    result['channels_used'].append('ocr')
                    result['coverage']['ocr'] = ocr.coverage()
                else:
                    result['providers']['ocr'].update(state='degraded' if ocr.state != 'down' else 'down',
                                                      reason=ocr.reason or 'observation_deadline')
                blind = not tree_usable and (lines is None or len(lines) < 3)
        if pixels and not result['unchanged'] and ('pixels' in channels or blind):
            result['frames'] = [pixels.frame(rect, wins, params.get('scale'))]
            if 'pixels' not in result['channels_used']:
                result['channels_used'].append('pixels')
        if any(c == 'ocr' and ocr is None or c == "tree" and tree is None or c == "pixels" and pixels is None for c in channels):
            result.update(unchanged=None, resync_required=True)
        return result

    def observe(self, peer, ident, params):
        deadline = self.deadline(params, 2000, 50, 10000)
        channels = params.get("channels", ["auto"])
        if (not isinstance(channels, list) or not channels or
                any(c not in ("auto", "state", "tree", "ocr", "pixels") for c in channels) or
                ("auto" in channels and channels != ["auto"])):
            raise RPCError("invalid_params")
        since = params.get("since_rev")
        if since is not None and (type(since) is not int or since < 0):
            raise RPCError("invalid_params")
        self.cache.selected(params.get("scope", {"kind": "session"}))
        if len(peer.waits) >= 8:
            raise RPCError("queue_full")
        probe = None
        tree = getattr(self, 'tree', None)
        probe_deadline = tree.clock() + max(0, deadline-time.monotonic()) if tree else None
        scope = params.get('scope', {})
        if (tree and scope.get('kind', 'session') == 'window' and any(
                w['handle'] == tree.target(scope) and w['mapped'] for w in self.cache.windows.values())):
            probe = tree.observe_probe(tree.target(scope))
        self.prune_history()
        full = not self.cache.known_revision(since)
        if full:
            pending = {"kind": "observe", "id": ident, "params": params,
                       "deadline": deadline, "pointer_pending": True,
                       "liveness_probe": probe, "liveness_deadline": probe_deadline}
            peer.waits.append(pending)
            def pointer(data):
                self.cache.set("pointer", {"x": data["root_x"], "y": data["root_y"]})
                pending["pointer_pending"] = False
            self.x.ax.ask(request.QueryPointer, pointer, window=self.x.root)
        elif (not self.covered() or not self.settle_pixels() or
              tree and not tree.observe_probe_ready(probe, probe_deadline)):
            peer.waits.append({"kind": "observe", "id": ident, "params": params,
                               "deadline": deadline, "liveness_probe": probe,
                               "liveness_deadline": probe_deadline})
        else:
            try:
                result = self.observation(params, wait_ocr=True)
            except OCRPending:
                peer.waits.append(dict(kind='observe', id=ident, params=params, deadline=deadline))
                return
            self.deliver_observation(peer, ident, params, result)

    def deliver_observation(self, peer, ident, params, result):
        # Check the actual JSON-RPC envelope before acknowledging reconciliation.
        # Live windows/provider payloads have no total byte bound; never let an
        # oversized full sample silently break the adapter's framing contract.
        if len(json_bytes({'jsonrpc': '2.0', 'id': ident, 'result': result})) > MAX_FRAME:
            self.respond(peer, ident, exc=RPCError('response_too_large', 'observe_frame_cap'))
            return
        self.observed(peer, params, result)
        self.respond(peer, ident, result)

    def observed(self, peer, params, result):
        if getattr(self, "act", None):
            self.act.observed(peer, params, result)
        token = getattr(self, 'lease', None)
        if (getattr(self, 'pixels', None) and token and peer is self.lease_peer
                and params.get('lease', token) == token):
            self.pixels.frames.pin_observation(token, result.get('frames', []))

    def predicate(self, expect):
        if getattr(self, "act", None):
            try:
                predicate_schema(expect)
                return self.act.evaluate(expect)
            except ActError as exc:
                raise RPCError(exc.reason, exc.detail, code=-32602)
        kind = expect.get("kind")
        supported = ("window_present", "window_absent", "window_focused", "dialog_present", "dialog_absent")
        if kind not in supported:
            if kind in ("text_equals", "text_contains", "node_present", "node_absent", "node_state",
                        "item_present", "item_absent", "ocr_text", "ocr_text_present", "ocr_text_absent",
                        "frame_matches", "visual_review", "region_changed", "region_stable", "tree", "ocr", "pixels"):
                return None
            raise RPCError("invalid_predicate")
        match = expect.get("match", {})
        if not isinstance(match, dict) or any(k not in ("title", "title_re", "class", "type") for k in match):
            raise RPCError("invalid_params")
        if any(not isinstance(v, str) or len(v) > 512 for v in match.values()):
            raise RPCError("invalid_params")
        pattern = match.get("title_re")
        if pattern is not None:
            try:
                regex = re.compile(pattern)
            except re.error:
                raise RPCError("invalid_params")
        if not self.covered():
            return None
        wins = [w for w in self.cache.windows.values() if w["mapped"]]
        if "window" in expect:
            handle = expect["window"]
            if not isinstance(handle, str) or not handle.startswith(f"{self.sid}/g{self.generation[:8]}/"):
                raise RPCError("stale_generation")
            wins = [w for w in wins if w["handle"] == handle]
        for key, val in match.items():
            wins = [w for w in wins if (bool(regex.search(w["title"])) if key == "title_re" else w[key] == val)]
        if kind.startswith("dialog_"):
            # X state proves only the exact window classifier, never the
            # deferred Thunar semantic rename classifier.
            if not match or not ("title" in match or "class" in match):
                return None
            wins = [w for w in wins if w["type"] == "dialog" or w["is_modal"] or w["transient_for"]]
            if "parent" in expect:
                parent = next((w for w in self.cache.windows.values() if w["handle"] == expect["parent"]), None)
                if parent is None:
                    raise RPCError("target_not_found")
                wins = [w for w in wins if w["family"] == parent["family"]]
        if kind == "window_focused":
            return any(w["handle"] == self.cache.focus for w in wins)
        return not wins if kind.endswith("absent") else bool(wins)

    def wait(self, peer, ident, params):
        deadline = self.deadline(params, 5000, 1, 30000)
        expect = params.get("expect", params.get("predicate"))
        if not isinstance(expect, dict):
            raise RPCError("invalid_params")
        satisfied = self.predicate(expect)
        undecided = bool(getattr(self, 'act', None) and self.act.tree_undecided(expect))
        if (satisfied is True or (satisfied is None and self.covered() and not undecided)) and self.settle_pixels():
            self.respond(peer, ident, self.wait_result(params, satisfied))
        elif len(peer.waits) >= 8:
            raise RPCError("queue_full")
        else:
            peer.waits.append({"kind": "wait", "id": ident, "params": params, "deadline": deadline})

    def wait_result(self, params, satisfied, timeout=False):
        if not self.settle_pixels():
            raise ActError("provider_degraded", "capture_pending")
        result = {"satisfied": satisfied, "rev": self.cache.rev,
                "evidence": (self.act.evidence(params.get('expect', params.get('predicate'))) if getattr(self, 'act', None) and
                             params.get('expect', params.get('predicate')) else [{"kind": "state", "rev": self.cache.rev}]) if satisfied else [],
                "state_delta": self.cache.observe({"kind": "session"}, params.get("since_rev"), self.covered()),
                "reason": "provider_degraded" if satisfied is None else "timeout" if timeout else None}
        return result

    def pending(self):
        for peer in list(self.peers):
            for item in list(peer.waits):
                expired = time.monotonic() >= item["deadline"]
                try:
                    if not self.settle_pixels():
                        if expired:
                            raise RPCError("provider_degraded", "capture_pending")
                        continue
                    if item["kind"] == "rpc":
                        peer.waits.remove(item)
                        self.message(peer, item["payload"])
                        continue
                    self.require_lease(peer, item["params"])
                    if item["kind"] == "observe":
                        if (getattr(self, 'tree', None) and not self.tree.observe_probe_ready(
                                item.get('liveness_probe'), item.get('liveness_deadline'))):
                            continue
                        if not expired and (not self.covered() or item.get("pointer_pending")):
                            continue
                        if (not expired and item["params"].get("since_rev") is None and
                                getattr(self, "tree", None) and self.tree.busy(item["params"])):
                            continue
                        try:
                            result = self.observation(item["params"], wait_ocr=not expired)
                        except OCRPending:
                            continue
                    else:
                        satisfied = self.predicate(item["params"].get("expect", item["params"].get("predicate")))
                        undecided = bool(getattr(self, 'act', None) and self.act.tree_undecided(
                            item['params'].get('expect', item['params'].get('predicate'))))
                        if not expired and satisfied is not True and not (satisfied is None and self.covered() and not undecided):
                            continue
                        result = self.wait_result(item["params"], satisfied, expired)
                except (RPCError, ActError) as exc:
                    peer.waits.remove(item)
                    self.respond(peer, item["id"], exc=exc if isinstance(exc, RPCError) else RPCError(exc.reason, exc.detail))
                    continue
                peer.waits.remove(item)
                if item["kind"] == "observe":
                    self.deliver_observation(peer, item["id"], item["params"], result)
                else:
                    self.respond(peer, item["id"], result)

    def prune_history(self):
        act = getattr(self, 'act', None)
        if not act or act.active is None:
            self.cache.prune_history()

    def ingest(self):
        events = self.x.ax.pump()
        self.x.inp_ax.pump()
        if self.x_errors:
            raise RuntimeError("worker_fault: " + str(self.x_errors[0]))
        self.x.events(events)
        self.poll_control()
        self.cache.commit(bool(events))
        if getattr(self, 'act', None):
            self.act.prune_windows()
        if getattr(self, "tree", None):
            self.tree.tick()
        if getattr(self, 'ocr', None):
            self.ocr.tick()
        self.prune_history()

    def run(self):
        failure = None
        try:
            self.tree = TreeProvider(self)
            self.ocr = OCRProvider(self)
            self.x = XState(self)
            self.selector.register(self.x.ev.fileno(), selectors.EVENT_READ, "ev")
            self.selector.register(self.x.inp.fileno(), selectors.EVENT_READ, "inp")
            while True:
                if self.stopping:
                    if self.act and self.act.evdev:
                        self.quiesce_evdev()
                    if self.stop_deadline is None:
                        if self.act and not self.act.stopping_tick():
                            self.ingest()
                            self.x.ax.flush()
                            self.x.inp_ax.flush()
                            self.selector.select(0.001)
                            continue
                        self.begin_stop()
                    if self.openbox is None or self.openbox.poll() is not None:
                        break
                    if time.monotonic() >= self.stop_deadline:
                        self.openbox.kill()
                    self.selector.select(0.02)
                    continue
                self.ingest()
                if not self.published and self.tree.wire is not None and not self.tree.ready:
                    self.x.ax.flush()
                    self.x.inp_ax.flush()
                    self.selector.select(0.01)
                    continue
                self.x.advance()
                if self.openbox and self.openbox.poll() is not None:
                    raise RuntimeError("worker_fault: openbox exited")
                if self.x.initialised and time.monotonic() >= self.watchdog:
                    self.watchdog_start()
                self.watchdog_finish()
                self.expire_lease()
                self.pending()
                if self.act:
                    self.act.tick()
                if not self.published and self.elapsed() > 10000:
                    raise RuntimeError("worker_start_timeout")
                self.x.ax.flush()
                self.x.inp_ax.flush()
                timeout = max(0, min(0.05, self.control_due - time.monotonic()))
                if self.act and (self.act.active or self.act.queue or self.act.selftest or
                                 self.act.evdev and self.act.evdev.recompile_runner is not None):
                    timeout = min(timeout, 0.001)
                if self.x.ax.pending or self.x.inp_ax.pending:
                    timeout = min(timeout, 0.01)
                for peer in self.peers:
                    for item in peer.waits:
                        timeout = min(timeout, max(0, item["deadline"] - time.monotonic()))
                ready = self.selector.select(timeout)
                # Drain readable X notifications before servicing driver RPCs
                # from the same readiness batch. An idle observe must not race
                # ahead of already-delivered DAMAGE on the sibling socket.
                if any(key.data in ("ev", "inp") for key, mask in ready):
                    self.ingest()
                for key, mask in ready:
                    if key.data == "signal":
                        try:
                            os.read(self.wake_r, 4096)
                        except BlockingIOError:
                            pass
                    elif key.data == "listener":
                        self.accept()
                    elif isinstance(key.data, Peer):
                        self.io(key.data, mask)
        except Exception as exc:
            failure = str(exc)
            self.stop_reason = "worker_fault"
            traceback.print_exc(file=sys.stderr)
        finally:
            self.cleanup(failure)
        return 1 if failure else 0

    def quiesce_evdev(self):
        # A helper may still be pacing a submitted request while the owner
        # drains its reply. Close the shared gate before release-only shutdown.
        # This path exists only for xorg; preserve an owner's closed state.
        try:
            with (self.sd / "control").open("r+b") as stream:
                with mmap.mmap(stream.fileno(), 64) as page:
                    current = decode_control(page[:], self.generation)
                    if current["state"] == STATES["agent"]:
                        control_store(page, 32, STATES["quiescing"], 32)
        except (OSError, ValueError):
            self.act.evdev.down("control_unavailable")

    def begin_stop(self):
        self.stop_deadline = time.monotonic() + 2
        if self.listener:
            try:
                self.selector.unregister(self.listener)
            except KeyError:
                pass
            self.listener.close()
        for peer in list(self.peers):
            self.disconnect(peer)
        # Registered FDs remain available even if an X connection is broken
        # and its fileno() can no longer be queried during failure cleanup.
        for key in list(self.selector.get_map().values()):
            if key.data in ("ev", "inp"):
                self.selector.unregister(key.fd)
        try:
            self.selector.unregister(self.wake_r)
        except KeyError:
            pass
        if self.openbox and self.openbox.poll() is None:
            self.openbox.terminate()

    def cleanup(self, failure):
        # Reap our child before touching selector/X resources: either may
        # already be broken on this path. Never report failed-start early.
        if getattr(self, "tree", None):
            self.tree.close()
        if getattr(self, 'ocr', None):
            self.ocr.close()
        if self.openbox:
            if self.openbox.poll() is None:
                self.openbox.terminate()
                if not wait_pid(self.openbox.pid, 2):
                    self.openbox.kill()
            self.openbox.wait()
        if self.stop_deadline is None:
            self.begin_stop()
        try:
            self.journal.append("worker_stop", reason=self.stop_reason, error=failure)
        finally:
            self.journal.close()
            if self.socket_bound:
                self.socket_path.unlink(missing_ok=True)
            if self.published:
                (self.sd / "worker.json").unlink(missing_ok=True)
            self.control_page.close()
            self.control_file.close()
            if getattr(self, "pixels", None):
                self.pixels.shadow.close()
            if self.act and self.act.evdev:
                self.act.evdev.close()
            if self.x:
                self.x.close()
            signal.set_wakeup_fd(-1)
            self.selector.close()
            os.close(self.wake_r)
            os.close(self.wake_w)
            if self.ready_fd is not None:
                self.notify({"session": self.sid, "state": "failed",
                             "error": failure or "worker_stopped"})


def worker_metadata(sd, state, sid):
    try:
        data = json.loads((sd / "worker.json").read_text())
        pid = data["pid"]
        if proc_identity(pid) and marked(pid, state, sid):
            args = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
            if data["generation"].encode() in args and b"--_daemon" in args:
                return data
    except (OSError, ValueError, KeyError):
        pass
    return None


def rpc_call(path, method, params=None, timeout=3):
    # CLI only; the daemon's sockets are always nonblocking.
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.settimeout(timeout)
        sock.connect(str(path))
        sock.sendall(frame({"jsonrpc": "2.0", "id": 1, "method": method, "params": params or {}}))
        def read(size):
            value = bytearray()
            while len(value) < size:
                chunk = sock.recv(size - len(value))
                if not chunk:
                    raise RuntimeError("worker_disconnected")
                value.extend(chunk)
            return value
        size = struct.unpack("!I", read(4))[0]
        if not 0 < size <= MAX_FRAME:
            raise RuntimeError("invalid_frame")
        response = json.loads(read(size))
        if "error" in response:
            raise RuntimeError(response["error"]["data"]["reason"])
        return response["result"]


def wait_pid(pid, seconds):
    with selectors.DefaultSelector() as sel:
        try:
            fd = os.pidfd_open(pid)
        except ProcessLookupError:
            return True
        try:
            sel.register(fd, selectors.EVENT_READ)
            return bool(sel.select(seconds))
        finally:
            os.close(fd)


def start(state, sid):
    with registry(state) as records:
        record = session_record(records, sid, state)
        sd = Path(record["session_dir"])
        if worker_metadata(sd, state, sid):
            raise RuntimeError("worker_already_running")
        generation = secrets.token_hex(16)
        (state / "acts").mkdir(mode=0o700, exist_ok=True)
        (sd / "logs").mkdir(exist_ok=True)
        (state / "acts" / (generation + ".jsonl")).touch(mode=0o600, exist_ok=False)
        initialise_control(sd / "control", generation)
        ready_r, ready_w = os.pipe()
        try:
            with (sd / "logs/worker.log").open("ab") as log:
                # Popen's exec is the daemon re-exec: markers are present in
                # /proc/environ from birth, before either X connection opens.
                child = subprocess.Popen([sys.executable, str(WM / "ark-worker"), "start",
                    "--session", sid, "--_daemon", "--_state", str(state),
                    "--_generation", generation, "--_ready-fd", str(ready_w),
                    "--_record", json.dumps(record)], env=session_env(record, state),
                    stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                    start_new_session=True, pass_fds=(ready_w,))
        finally:
            os.close(ready_w)
        startup_failed = True
        try:
            with selectors.DefaultSelector() as sel:
                sel.register(ready_r, selectors.EVENT_READ)
                if not sel.select(15):
                    raise RuntimeError("worker_start_timeout")
                data = os.read(ready_r, 65536)
            if not data:
                raise RuntimeError("worker_fault: see SD/logs/worker.log")
            result = json.loads(data)
            startup_failed = result.get("state") != "ready"
            return result
        finally:
            os.close(ready_r)
            if startup_failed:
                # The daemon owns a fresh session/process group; Openbox
                # inherits it. Cover even daemon death/forced timeout where
                # its finally block cannot run, without sweeping session apps.
                try:
                    os.killpg(child.pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
                wait_pid(child.pid, 4)
                try:
                    os.killpg(child.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                child.wait()


def command(args):
    state = STATE
    if args._daemon:
        state = Path(args._state)
        record = json.loads(args._record)
        if record["session"] != args.session or not marked(os.getpid(), state, args.session):
            raise RuntimeError("invalid_daemon_context")
        worker = Worker(state, record, args._generation, args._ready_fd)
        return None, worker.run()
    if args.command == "start":
        result = start(state, args.session)
        return result, 0 if result.get("state") == "ready" else 1
    with registry(state) as records:
        if args.session not in records:
            raise RuntimeError("unknown_session")
        record = records[args.session]
        sd = Path(record["session_dir"])
        metadata = worker_metadata(sd, state, args.session)
        if not metadata:
            if args.command == "stop":
                (sd / "driver/act.sock").unlink(missing_ok=True)
                (sd / "worker.json").unlink(missing_ok=True)
                return {"session": args.session, "state": "stopped", "ok": True}, 0
            raise RuntimeError("worker_not_running")
    if args.command == "status":
        return rpc_call(metadata["socket"], "system.info"), 0
    if args.command == "tree-dump":
        return rpc_call(metadata["socket"], "debug.tree_dump", {"window": args.window}), 0
    if args.command == "stop":
        os.kill(metadata["pid"], signal.SIGTERM)
        if not wait_pid(metadata["pid"], 5):
            raise RuntimeError("worker_stop_timeout")
        return {"session": args.session, "state": "stopped", "ok": True}, 0
    with (sd / "control").open("r+b") as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        with mmap.mmap(stream.fileno(), 64) as page:
            previous = decode_control(page[:], metadata["generation"])
            epoch = previous["epoch"] + 1
            # Clear-fence is explicit owner authority, carried with a fresh
            # epoch. It never opens unresolved-effect admission by itself.
            flags = (previous["flags"] | 1) if getattr(args, "clear_fence", False) else (previous["flags"] & ~1)
            control_store(page, 36, flags, 32)
            transition_control(page, STATES[args.state], epoch)
            page.flush()
        os.fsync(stream.fileno())
        # Keep the writer lock through acknowledgement: each CLI transition
        # must be observed and fsynced by the sole journal writer.
        until = time.monotonic() + 3
        with selectors.DefaultSelector() as sel:
            while time.monotonic() < until:
                health = rpc_call(metadata["socket"], "system.info")
                if health["control"]["epoch"] == epoch and health["control"]["state"] == args.state:
                    return {"session": args.session, "state": args.state, "control_epoch": epoch}, 0
                sel.select(0.01)
        raise RuntimeError("control_ack_timeout")


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise RuntimeError("invalid_arguments: " + message)


def main():
    parser = Parser(description=__doc__)
    parser.add_argument("command", choices=("start", "stop", "status", "control", "tree-dump"))
    parser.add_argument("--session", required=True)
    parser.add_argument("--state", choices=("agent", "paused", "human"))
    parser.add_argument("--window")
    parser.add_argument("--clear-fence", action="store_true")
    for flag in ("daemon", "state", "generation", "record"):
        parser.add_argument("--_" + flag, action="store_true" if flag == "daemon" else "store",
                            help=argparse.SUPPRESS)
    parser.add_argument("--_ready-fd", type=int, help=argparse.SUPPRESS)
    args = None
    try:
        args = parser.parse_args()
        if args.command == "tree-dump" and not args.window:
            raise RuntimeError("invalid_arguments: tree-dump requires --window")
        if args.command == "control" and args.state is None:
            raise RuntimeError("invalid_arguments: control requires --state")
        if args.clear_fence and (args.command != "control" or args.state != "agent"):
            raise RuntimeError("invalid_arguments: clear-fence requires control --state agent")
        result, code = command(args)
    except Exception as exc:
        result = {"session": args.session if args else None, "state": "failed", "error": str(exc)}
        code = 1
    if result is not None:
        if args and args.command == "tree-dump" and code == 0:
            print(result["path"])
        else:
            print(json.dumps(result, ensure_ascii=False, allow_nan=False))
    return code


if __name__ == "__main__":
    sys.exit(main())
