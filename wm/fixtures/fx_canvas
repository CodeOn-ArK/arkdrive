#!/usr/bin/python3
# Known strings and Cairo baseline positions, in drawing-area pixels:
#   "ArkDrive canvas" at (24, 52)
#   "Alpha 123"       at (24, 112)
#   "Bravo 456"       at (260, 172)
#   "Target: W0"      at (24, 232)
# White background, black Sans normal 24 px. Area: 560 x 280 px.
# All text is painted; the drawing area's accessible object has zero children
# and exposes no text interface. Window decorations are outside this area.
"""Pixel/OCR fixture with no accessible text controls."""

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk


STRINGS = (("ArkDrive canvas", 24, 52), ("Alpha 123", 24, 112),
           ("Bravo 456", 260, 172), ("Target: W0", 24, 232))


def draw(_area, context):
    context.set_source_rgb(1, 1, 1)
    context.paint()
    context.set_source_rgb(0, 0, 0)
    context.select_font_face("Sans")
    context.set_font_size(24)
    for text, x, y in STRINGS:
        context.move_to(x, y)
        context.show_text(text)
    return False


def main():
    window = Gtk.Window(title="fx_canvas")
    window.set_resizable(False)
    window.connect("destroy", Gtk.main_quit)
    area = Gtk.DrawingArea()
    area.set_size_request(560, 280)
    area.connect("draw", draw)
    window.add(area)
    window.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
