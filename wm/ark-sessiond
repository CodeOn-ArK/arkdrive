#!/usr/bin/env python3
"""One-shot, stdlib-only session manager; see SPEC.md for the v0 contract."""

import argparse
from contextlib import contextmanager
from datetime import datetime, timezone
import errno
import fcntl
import json
import os
from pathlib import Path
import re
import secrets
import signal
import socket
import subprocess
import sys
import time

from input_protocol import close_control_gate
from worker_housekeeping import cap_logs, reclaim_scratch, matches_instance
from wm_registry import (atomic_json, metadata, retire, by_incarnation,
                         durable_mkdir, sync_directory)


STATE = Path(os.path.expanduser("~/.local/state/ark-sessiond")).absolute()
WM = Path(__file__).resolve().parent
RULE = Path("/etc/udev/rules.d/49-arkdrive-sessiond.rules")
RULE_TEXT = ('SUBSYSTEM=="input", ATTR{name}=="ArkDrive *", ENV{ID_INPUT}="0", '
             'ENV{LIBINPUT_IGNORE_DEVICE}="1", ENV{ID_SEAT}="seat-arkdrive", TAG+="seat"\n')
PID_FIELDS = ("pid_x", "pid_dbus", "pid_atspi_launcher", "pid_registryd", "mkdevs_pid", "mkdevs_supervisor_pid", "pid_log_guard")


def milliseconds(start):
    return int((time.monotonic() - start) * 1000)


@contextmanager
def locked_registry():
    STATE.mkdir(parents=True, mode=0o700, exist_ok=True)
    with (STATE / ".lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        path = STATE / "sessions.json"
        records = json.loads(path.read_text()) if path.exists() else {}
        changed = False
        for record in records.values():
            changed = metadata(STATE, record) or changed
            cap_logs(record['session_dir'])
        if changed:
            save_registry(records)
        yield records


def save_registry(records):
    # Call only with .lock held; replace atomically to avoid partial JSON.
    atomic_json(STATE / 'sessions.json', records)


def journal(sid, action, ok, start, **extras):
    # Call only with .lock held, also serializing journal appends.
    entry = {"ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
             "session": sid, "action": action, "ok": ok,
             "duration_ms": milliseconds(start), **extras}
    with (STATE / "journal.jsonl").open("a") as stream:
        stream.write(json.dumps(entry) + "\n")
        stream.flush()
        os.fsync(stream.fileno())


def alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        # A zombie has exited even if its parent has not reaped it yet.
        stat = Path(f"/proc/{pid}/stat").read_text()
        return stat.rsplit(")", 1)[1].split()[0] != "Z"
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except FileNotFoundError:
        return False


def session_env(record):
    env = os.environ.copy()
    env.update(ARK_SESSIOND=str(STATE), ARK_SESSION_ID=record["session"],
               HOME=record["home"], XDG_RUNTIME_DIR=record["runtime_dir"],
               DISPLAY=f':{record["display"]}')
    # Do not inherit a host accessibility/session bus before our own exists.
    env.pop("AT_SPI_BUS_ADDRESS", None)
    env.pop("DBUS_SESSION_BUS_ADDRESS", None)
    if record.get("bus_address"):
        env["DBUS_SESSION_BUS_ADDRESS"] = record["bus_address"]
    if record.get("atspi_address"):
        env["AT_SPI_BUS_ADDRESS"] = record["atspi_address"]
    if record.get('instance'):
        env['ARK_SESSION_INSTANCE'] = record['instance']
    else:
        env.pop('ARK_SESSION_INSTANCE', None)
    return env


def root_command(record, cmd):
    return ["sudo", "-n", "env", f"ARK_SESSIOND={STATE}",
            f'ARK_SESSION_ID={record["session"]}',
            *([f'ARK_SESSION_INSTANCE={record["instance"]}'] if record.get('instance') else []),
            *map(str, cmd)]


def execute(record, cmd, *, root=False, **kwargs):
    command = root_command(record, cmd) if root else list(map(str, cmd))
    result = subprocess.run(command, env=session_env(record), text=True,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, **kwargs)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or
                           f"{cmd[0]} exited with code {result.returncode}")
    return result.stdout


def spawn(record, cmd, log, *, root=False):
    cap_logs(record['session_dir'])
    command = root_command(record, cmd) if root else list(map(str, cmd))
    with (Path(record["session_dir"]) / "logs" / log).open("ab") as stream:
        return subprocess.Popen(command, env=session_env(record),
                                stdout=stream, stderr=stream, start_new_session=True)


def wait_exit(pids, seconds):
    deadline = time.monotonic() + seconds
    while any(alive(pid) for pid in pids) and time.monotonic() < deadline:
        time.sleep(0.05)


class UnsafeTeardown(RuntimeError):
    pass


def require_helper_dead(record):
    if record['profile'] == 'xorg':
        if record.get('mkdevs_supervisor_pid'):
            # The record's child pid predates any respawns. Once the
            # supervisor is dead this final pidfile is stable.
            try:
                record['mkdevs_pid'] = int((Path(record['session_dir']) / 'devices.json.pid').read_text())
            except FileNotFoundError:
                if (record.get('startup_complete', True) or record.get('pid_x') or
                        record.get('mkdevs_pid')):
                    raise UnsafeTeardown('cannot establish final helper pid; refusing to signal Xorg')
            except (OSError, ValueError):
                raise UnsafeTeardown('cannot establish final helper pid; refusing to signal Xorg')
        if any(alive(record.get(key)) for key in ('mkdevs_pid', 'mkdevs_supervisor_pid')):
            raise UnsafeTeardown('teardown aborted: mkdevs helper is still alive; refusing to signal Xorg')


def send_signal(record, pid, sig):
    if record['profile'] == 'xorg' and pid == record.get('pid_x'):
        require_helper_dead(record)
    if not alive(pid):
        return
    try:
        os.kill(pid, sig)
    except ProcessLookupError:
        pass
    except PermissionError:
        execute(record, ["kill", f"-{sig}", str(pid)], root=True)


# Spike A's /proc environ marker sweep, with exact matching of both markers.
# Root scans are needed for the xorg helpers, whose environ is root-only.
SCAN_CODE = r'''
import json, os, pathlib, sys
markers = {os.fsencode("ARK_SESSIOND=" + sys.argv[1]),
           os.fsencode("ARK_SESSION_ID=" + sys.argv[2])}
if len(sys.argv) > 4:
    markers.add(os.fsencode("ARK_SESSION_INSTANCE=" + sys.argv[4]))
excluded = {os.getpid(), os.getppid(), int(sys.argv[3])}
pids = []
for entry in pathlib.Path("/proc").iterdir():
    if not entry.name.isdigit() or int(entry.name) in excluded:
        continue
    try:
        if markers.issubset(set((entry / "environ").read_bytes().split(b"\0"))):
            pids.append(int(entry.name))
    except OSError:
        pass
print(json.dumps(pids))
'''


def marked_pids(record):
    if record["profile"] == "xorg":
        return json.loads(execute(record, ["python3", "-c", SCAN_CODE,
                              str(STATE), record["session"], str(os.getpid()),
                              *([record['instance']] if record.get('instance') else [])], root=True))
    markers = {os.fsencode(f"ARK_SESSIOND={STATE}"),
               os.fsencode(f'ARK_SESSION_ID={record["session"]}')}
    if record.get('instance'):
        markers.add(os.fsencode(f'ARK_SESSION_INSTANCE={record["instance"]}'))
    pids = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit() or int(entry.name) == os.getpid():
            continue
        try:
            if markers.issubset(set((entry / "environ").read_bytes().split(b"\0"))):
                pids.append(int(entry.name))
        except OSError:
            pass
    return pids


def teardown(record, records, *, retain=False):
    """Section 8, shared by stop and failed starts; caller journals once."""
    errors = []
    directory = Path(record['session_dir'])
    if not directory.exists() and not record.get('startup_complete', True):
        # A durable reservation can be stopped before any scratch/process exists.
        if not retain:
            retire(STATE, record)
            records.pop(record['session'], None)
        save_registry(records)
        return
    if record['profile'] == 'xorg' and not record.get('startup_complete', True):
        # The controller may have died during wait_file, before a checkpoint.
        # sessiond alone must recover these identities, not depend on wmctl.
        for name, field in (('devices.json.supervisor.pid', 'mkdevs_supervisor_pid'),
                            ('devices.json.pid', 'mkdevs_pid'), ('xorg.pid', 'pid_x')):
            try:
                record[field] = int((directory / name).read_text())
            except FileNotFoundError:
                pass

    def attempt(operation):
        try:
            operation()
        except UnsafeTeardown:
            raise  # Keep the session record and Xorg/grabs intact for recovery.
        except Exception as exc:
            errors.append(str(exc))

    if record["profile"] == "xorg":
        # A gate-write error aborts teardown before quit or any process signal.
        directory = Path(record['session_dir'])
        if record.get('mkdevs_supervisor_pid') or (directory / 'helper.lock').exists():
            with (directory / 'helper.lock').open('a') as lock:
                fcntl.flock(lock, fcntl.LOCK_EX)
                close_control_gate(directory / 'control')
                (directory / 'helper.stopping').touch()
        else:
            close_control_gate(directory / 'control')
        def quit_devices():
            try:
                fd = os.open(Path(record["session_dir"]) / "cmd.fifo",
                             os.O_WRONLY | os.O_NONBLOCK)
            except OSError as exc:
                if exc.errno in (errno.ENXIO, errno.ENOENT):
                    return
                raise
            try:
                os.write(fd, b"quit\n")
            finally:
                os.close(fd)
        attempt(quit_devices)
        supervisor = record.get('mkdevs_supervisor_pid')
        if supervisor:
            wait_exit([supervisor], 5)
            if alive(supervisor):
                attempt(lambda: send_signal(record, supervisor, signal.SIGKILL))
                wait_exit([supervisor], 5)
            if alive(supervisor):
                raise UnsafeTeardown('mkdevs supervisor is still alive; refusing to signal Xorg')
            try:
                record['mkdevs_pid'] = int((directory / 'devices.json.pid').read_text())
            except (OSError, ValueError):
                # During failed startup there may never have been a child.
                if record.get('mkdevs_pid'):
                    raise UnsafeTeardown('cannot establish final helper pid; refusing to signal Xorg')
        helper = record.get('mkdevs_pid')
        wait_exit([helper], 5)
        if alive(helper):
            attempt(lambda: send_signal(record, helper, signal.SIGKILL))
            wait_exit([helper], 5)
        require_helper_dead(record)
    pids = [record.get(field) for field in PID_FIELDS if record.get(field)]
    for pid in pids:
        attempt(lambda pid=pid: send_signal(record, pid, signal.SIGTERM))
    wait_exit(pids, 1)
    try:
        for pid in marked_pids(record):
            attempt(lambda pid=pid: send_signal(record, pid, signal.SIGTERM))
        time.sleep(1)
        for pid in marked_pids(record):
            attempt(lambda pid=pid: send_signal(record, pid, signal.SIGKILL))
        wait_exit(pids, 1)
    except UnsafeTeardown:
        raise
    except Exception as exc:
        errors.append(str(exc))
    if record["profile"] == "xorg":
        attempt(lambda: execute(record, ["rm", "-f",
                f'/etc/X11/ark-sessiond-{record["display"]}.conf'], root=True))
        if not any(r["profile"] == "xorg" and sid != record["session"]
                   for sid, r in records.items()):
            attempt(lambda: execute(record, ["rm", "-f", str(RULE)], root=True))
            attempt(lambda: execute(record, ["udevadm", "control", "--reload-rules"], root=True))
    if not alive(record.get("pid_x")) and record.get("display") is not None:
        for path in (Path(f'/tmp/.X{record["display"]}-lock'),
                     Path(f'/tmp/.X11-unix/X{record["display"]}')):
            def remove(path=path):
                try:
                    path.unlink(missing_ok=True)
                except PermissionError:
                    execute(record, ["rm", "-f", str(path)], root=True)
            attempt(remove)
    if errors:
        raise RuntimeError("; ".join(errors))
    # A successful signal is not proof of process death. Preserve the registry
    # and all scratch on any surviving PID, failed scan or incomplete teardown.
    survivors = [pid for pid in pids if alive(pid)] + marked_pids(record)
    if survivors:
        raise UnsafeTeardown('session processes still alive; retaining scratch and registry')
    directory = Path(record['session_dir'])
    if (record.get('instance') and directory.exists() and
            (record.get('startup_complete', True) or (directory / '.instance').exists()) and
            not matches_instance(directory, record['instance'])):
        raise UnsafeTeardown('session instance mismatch; retaining scratch and registry')
    reclaim_scratch(record)
    if not retain:
        retire(STATE, record)
        records.pop(record["session"], None)
        active = {r.get('incarnation') for r in records.values()}
        for other in records.values():
            if 'attention' in other:
                other['attention'] = [a for a in other['attention'] if a.get('incarnation') in active]
    save_registry(records)


def wait_display(record, process=None):
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        if (process is not None and process.poll() is not None) or not alive(record["pid_x"]):
            raise RuntimeError("X server exited before readiness")
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                sock.settimeout(0.05)
                sock.connect(f'/tmp/.X11-unix/X{record["display"]}')
            return
        except OSError:
            time.sleep(0.05)
    raise RuntimeError("X server readiness timed out")


def wait_file(path, seconds, process, record=None, pid_field=None):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if record is not None:
            pidfile = path if pid_field == "pid_x" else Path(str(path) + ".pid")
            try:
                record[pid_field] = int(pidfile.read_text().strip())
            except (FileNotFoundError, ValueError):
                pass
        try:
            value = path.read_text()
            if value.strip():
                return value
        except FileNotFoundError:
            pass
        if process.poll() is not None:
            raise RuntimeError(f"helper exited before creating {path.name}")
        time.sleep(0.05)
    raise RuntimeError(f"timed out waiting for {path.name}")


def start_xorg(record, records, timings):
    start = time.monotonic()
    live_names = {f'ArkDrive {sid} {kind}' for sid, r in records.items()
                  if alive(r.get("pid_x")) for kind in ("kbd", "ptr")}
    for path in Path("/sys/class/input").glob("event*/device/name"):
        try:
            name = path.read_text().strip()
        except OSError:
            continue
        if name.startswith("ArkDrive ") and name not in live_names:
            raise RuntimeError(f"stale device: {name}")
    if not RULE.exists() or RULE.read_text() != RULE_TEXT:
        execute(record, ["tee", str(RULE)], root=True, input=RULE_TEXT)
        execute(record, ["udevadm", "control", "--reload-rules"], root=True)
    directory = Path(record["session_dir"])
    fifo = directory / "cmd.fifo"
    os.mkfifo(fifo)
    # Sessiond must retain write access to the fork/stop lock. Letting the
    # privileged supervisor create it would leave a root-owned 0644 file.
    (directory / 'helper.lock').touch(mode=0o600)
    helper = spawn(record, ["python3", WM / "mkdevs.py", "--fifo", fifo,
                    "--devices-json", directory / "devices.json", "--name-prefix",
                    f'ArkDrive {record["session"]}',
                    "--event-socket", directory / "input.sock",
                    "--owner-uid", str(os.getuid()),
                    "--control", directory / "control", "--supervise"], "mkdevs.log", root=True)
    record['mkdevs_supervisor_pid'] = int(wait_file(directory / 'devices.json.supervisor.pid', 10, helper))
    save_registry(records)
    raw = wait_file(directory / "devices.json", 10, helper, record, "mkdevs_pid")
    record["mkdevs_pid"] = int((directory / "devices.json.pid").read_text())
    save_registry(records)
    record["devices"] = json.loads(raw)
    kbd, ptr = record["devices"]["kbd"], record["devices"]["ptr"]
    time.sleep(1)
    execute(record, ["chmod", "600", kbd, ptr], root=True)
    execute(record, ["chown", str(os.getuid()), kbd, ptr], root=True)
    for node in (kbd, ptr):
        properties = execute(record, ["udevadm", "info", "-q", "property", "-n", node])
        if "ID_SEAT=seat-arkdrive" not in properties.splitlines():
            raise RuntimeError(f"device is not on seat-arkdrive: {node}")
    timings["devices_ms"] = milliseconds(start)
    start = time.monotonic()
    conf = directory / "xorg.conf"
    conf.write_text((WM / "xorg.conf.tmpl").read_text().replace("@KBD@", kbd).replace("@PTR@", ptr))
    confname = f'ark-sessiond-{record["display"]}.conf'
    execute(record, ["cp", conf, f"/etc/X11/{confname}"], root=True)
    record["vt"] = record["display"] - 84
    launcher = spawn(record, ["bash", WM / "ark-xorg-launch.sh", directory / "xorg.pid",
                       f':{record["display"]}', confname, f'vt{record["vt"]}'],
                     "xorg-launch.log", root=True)
    record["pid_x"] = int(wait_file(directory / "xorg.pid", 5, launcher, record, "pid_x"))
    save_registry(records)
    wait_display(record)
    attach = (["reattach", "kbd", "Virtual core keyboard"],
              ["reattach", "ptr", "Virtual core pointer"], ["enable", "kbd"],
              ["enable", "ptr"], ["set-prop", "ptr", "Device Accel Profile", "-1"])
    for trial in range(5):
        try:
            for args in attach:
                execute(record, ["xinput", *args])
            for device in ("kbd", "ptr"):
                props = execute(record, ["xinput", "list-props", device])
                if not re.search(r"^\s*Device Enabled \([0-9]+\):\s*1\s*$", props, re.M):
                    raise RuntimeError(f"device not enabled: {device}")
            break
        except RuntimeError:
            if trial == 4:
                raise
            time.sleep(0.3)
    timings["xorg_ms"] = milliseconds(start)


def allocate_session(profile, records, *, incarnation=None):
    sid = f's{max((int(s[1:]) for s in records), default=0) + 1}'
    instance = secrets.token_hex(16)
    directory = STATE / "run" / sid / instance
    record = {"session": sid, "instance": instance, "profile": profile, "display": None,
              "pid_x": None, "pid_dbus": None, "bus_address": None,
              "atspi_address": None, "pid_atspi_launcher": None,
              "pid_registryd": None, "home": str(directory / "home"),
              "runtime_dir": str(directory / "runtime"),
              "session_dir": str(directory), "created_at": time.time(), 'startup_complete': False}
    metadata(STATE, record)
    if incarnation is not None:
        record['incarnation'] = record['root_incarnation'] = incarnation
    record['lifecycle'] = 'reserved'
    if profile == "xorg":
        record.update(vt=None, devices={}, mkdevs_pid=None, mkdevs_supervisor_pid=None)
    records[sid] = record
    return record


def start_session(profile):
    with locked_registry() as records:
        record = allocate_session(profile, records)
        save_registry(records)
        return launch_session(record, records)


def launch_session(record, records):
    """Caller holds registry lock; reservation already exists durably.

    A recovered 'creating' record must be reaped before calling this again.
    Every subprocess inherits the incarnation-scoped process sweep markers.
    """
    start = time.monotonic()
    sid, profile = record['session'], record['profile']
    directory, instance = Path(record['session_dir']), record['instance']
    record['lifecycle'] = 'creating'
    save_registry(records)
    timings = {}
    try:
        used = {r["display"] for r in records.values() if alive(r.get("pid_x"))}
        record["display"] = next((d for d in range(91, 121) if d not in used
            and not os.path.lexists(f"/tmp/.X{d}-lock")
            and not os.path.lexists(f"/tmp/.X11-unix/X{d}")), None)
        if record["display"] is None:
            raise RuntimeError("no free display in 91..120")
        save_registry(records)
        durable_mkdir(directory)
        with (directory / '.instance').open('w') as marker:
            marker.write(instance + '\n')
            marker.flush()
            os.fsync(marker.fileno())
        sync_directory(directory)
        for name in ("home", "runtime", "logs"):
            (directory / name).mkdir(mode=0o700, exist_ok=True)
        (directory / "runtime").chmod(0o700)
        record['pid_log_guard'] = subprocess.Popen(
            ['python3', str(WM / 'worker_housekeeping.py'), '--guard', str(directory),
             '--instance', instance], env=session_env(record), stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True).pid
        save_registry(records)
        # Session ids may be reused after stop; discard old helper outputs.
        for name in ("devices.json", "devices.json.pid", "devices.json.supervisor.pid", "helper.stopping",
                     "xorg.pid", "cmd.fifo", "input.sock", "input.sock.instance"):
            path = directory / name
            if path.exists():
                path.unlink()
        display_start = time.monotonic()
        if profile == "xvfb":
            (directory / "fb").mkdir(exist_ok=True)
            process = spawn(record, ["Xvfb", f':{record["display"]}', "-screen", "0",
                                    "1920x1080x24", "-nolisten", "tcp",
                                    "-fbdir", directory / "fb"], "xvfb.log")
            record["pid_x"] = process.pid
            save_registry(records)
            wait_display(record, process)
        else:
            start_xorg(record, records, timings)
        timings["display_ms"] = milliseconds(display_start)
        bus_start = time.monotonic()
        output = execute(record, ["dbus-daemon", "--session", "--fork",
                                  "--print-address=1", "--print-pid=1"])
        lines = output.splitlines()
        record["pid_dbus"] = int(lines[1])
        save_registry(records)
        record["bus_address"] = lines[0]
        timings["bus_ms"] = milliseconds(bus_start)
        atspi_start = time.monotonic()
        record["pid_atspi_launcher"] = spawn(record, ["/usr/libexec/at-spi-bus-launcher"],
                                                   "atspi-launcher.log").pid
        save_registry(records)
        time.sleep(0.5)
        record["pid_registryd"] = spawn(record, ["/usr/libexec/at-spi2-registryd"],
                                              "registryd.log").pid
        save_registry(records)
        deadline = time.monotonic() + 6
        while time.monotonic() < deadline:
            try:
                response = execute(record, ["gdbus", "call", "--session", "--dest",
                    "org.a11y.Bus", "--object-path", "/org/a11y/bus", "--method",
                    "org.a11y.Bus.GetAddress"], timeout=max(0.01, deadline - time.monotonic()))
                match = re.search(r'''unix:[^"',)]+''', response)
                if match:
                    record["atspi_address"] = match.group()
                    break
            except (RuntimeError, subprocess.TimeoutExpired):
                pass
            time.sleep(min(0.25, max(0, deadline - time.monotonic())))
        if not record["atspi_address"]:
            raise RuntimeError("AT-SPI GetAddress timed out")
        timings["atspi_ms"] = milliseconds(atspi_start)
        record["lifecycle"] = "ready"
        record['startup_complete'] = True
        records[sid] = record
        save_registry(records)
        journal(sid, "start", True, start, profile=profile)
        timings["total_ms"] = milliseconds(start)
        return {"session": sid, "incarnation": record["incarnation"], "display": f':{record["display"]}',
                "profile": profile, "state": "ready", "timings": timings}, 0
    except Exception as exc:
        error = str(exc)
        try:
            teardown(record, records)
        except Exception as cleanup_exc:
            error += f"; cleanup: {cleanup_exc}"
        journal(sid, "start", False, start, profile=profile, error=error)
        return {"session": sid, "state": "failed", "error": error}, 1


def list_sessions():
    with locked_registry() as records:
        return {"sessions": [{"session": sid, "incarnation": r['incarnation'],
                  "parent_incarnation": r['parent_incarnation'], 'depth': r['depth'],
                  'children': r['children'], 'budget': r['budget'],
                  'task': r['task'], 'result': r['result'], 'attention': r['attention'],
                  'lifecycle': r['lifecycle'], "profile": r["profile"],
                  "display": f':{r["display"]}', "pid": r["pid_x"],
                  "uptime_s": int(time.time() - r["created_at"]),
                  "state": "ready" if alive(r["pid_x"]) else "dead"}
                 for sid, r in sorted(records.items(), key=lambda item: int(item[0][1:]))]}, 0


def run_session(sid, cmd):
    start = time.monotonic()
    with locked_registry() as records:
        record = records.get(sid)
        if record is None:
            journal(sid, "run", False, start, exit_code=2, cmd=cmd, error="unknown session")
            return {"error": "unknown session", "session": sid}, 2
    error = None
    try:
        code = subprocess.run(cmd, cwd=record["home"], env=session_env(record),
                              stdout=sys.stderr, stderr=sys.stderr).returncode
        if code:
            error = f"command exited with code {code}"
    except OSError as exc:
        code = 127 if isinstance(exc, FileNotFoundError) else 126
        error = str(exc)
    with locked_registry():
        journal(sid, "run", code == 0, start, exit_code=code, cmd=cmd,
                **({"error": error} if error else {}))
    return {"session": sid, "exit_code": code,
            "duration_ms": milliseconds(start), "ok": code == 0}, code


def stop_tree(records, sid=None):
    """Close gates top-down, reap bottom-up, entirely from registry data.

    If a descendant cannot be proved dead, retain its ancestors for retry.
    The durable stopping flag also prevents a recovered spawn intent from
    resurrecting a stopped tree.
    """
    preorder, postorder, visited = [], [], set()

    def visit(record):
        incarnation = record['incarnation']
        if incarnation in visited:
            return
        visited.add(incarnation)
        preorder.append(record)
        # Parent links are authoritative; also honour persisted children links
        # for conservative reap of a partially migrated/inconsistent registry.
        for child in list(records.values()):
            if (child.get('parent_incarnation') == incarnation or
                    child.get('incarnation') in record.get('children', [])):
                visit(child)
        postorder.append(record)

    if sid is None:
        for record in sorted(records.values(), key=lambda r: r.get('depth', 0)):
            visit(record)
    else:
        visit(records[sid])
    # Fail closed even if the next gate write or process reap fails.
    for record in preorder:
        record['lifecycle'], record['control_state'] = 'stopping', 'QUIESCING'
    save_registry(records)
    for record in preorder:
        close_control_gate(Path(record['session_dir']) / 'control')
        journal(record['session'], 'stop.gate', True, time.monotonic(),
                incarnation=record['incarnation'])
    stopped, errors = [], []
    for record in postorder:
        incarnation = record['incarnation']
        if any(r.get('parent_incarnation') == incarnation or
               r.get('incarnation') in record.get('children', [])
               for r in records.values() if r is not record):
            errors.append(record['session'] + ': descendant retained')
            continue
        try:
            teardown(record, records)
            stopped.append(incarnation)
            journal(record['session'], 'stop.reaped', True, time.monotonic(),
                    incarnation=incarnation)
        except Exception as exc:
            errors.append(record['session'] + ': ' + str(exc))
    return stopped, errors


def stop_sessions(sid, *, incarnation=None):
    start = time.monotonic()
    with locked_registry() as records:
        if incarnation is not None:
            record = by_incarnation(records, incarnation)
            if record is None:
                # Incarnation-scoped stop is idempotent, never resolves a reused sN.
                return {'incarnation': incarnation, 'state': 'stopped', 'ok': True}, 0
            sid = record['session']
        if sid is not None and sid not in records:
            journal(sid, "stop", False, start, error="unknown session")
            return {"error": "unknown session", "session": sid}, 2
        targets = list(records)
        stopped, errors = stop_tree(records, sid)
        journal(sid, "stop", not errors, start,
                **({"error": "; ".join(errors)} if errors else {}))
        if errors:
            return {"session": sid, "ok": False, "error": "; ".join(errors)}, 1
        if sid is None:
            return {"stopped": targets, 'incarnations': stopped, "ok": True}, 0
        return {"session": sid, "state": "stopped", 'incarnations': stopped, "ok": True}, 0


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise ValueError(message)

    def print_help(self, file=None):
        print(json.dumps({"help": self.format_help()}), file=file or sys.stdout)


def main():
    parser = Parser(description=__doc__)
    commands = parser.add_subparsers(dest="action", required=True)
    start = commands.add_parser("start")
    start.add_argument("--profile", choices=("xvfb", "xorg"), required=True)
    commands.add_parser("list")
    run = commands.add_parser("run")
    run.add_argument("--session", required=True)
    run.add_argument("cmd", nargs=argparse.REMAINDER)
    stop = commands.add_parser("stop")
    target = stop.add_mutually_exclusive_group(required=True)
    target.add_argument("--session")
    target.add_argument("--incarnation")
    target.add_argument("--all", action="store_true")
    try:
        args = parser.parse_args()
        if args.action == "start":
            result, code = start_session(args.profile)
        elif args.action == "list":
            result, code = list_sessions()
        elif args.action == "run":
            cmd = args.cmd[1:] if args.cmd[:1] == ["--"] else args.cmd
            if not cmd:
                raise ValueError("run requires a command after --")
            result, code = run_session(args.session, cmd)
        else:
            result, code = stop_sessions(args.session, incarnation=args.incarnation)
    except ValueError as exc:
        result, code = {"error": str(exc)}, 2
    except Exception as exc:
        result, code = {"error": str(exc)}, 1
    print(json.dumps(result), flush=True)
    return code


if __name__ == "__main__":
    sys.exit(main())
